{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": null, "artifact_path": "kb/sources/international/ITU_T_Y3172_2019.pdf", "artifact_sha256": "e42f9a3be3f951d3e19b9007f876f0b389c81b4693f0d8576e18185a1acfe67b", "binding_finding_eligible": false, "binding_finding_status": "requires_project_specific_applicability_review", "binding_level": "technical_standard", "clause_number": "3.2.6", "column": "not_applicable", "contextual_evidence_eligible": true, "exact_source_excerpt": "machine learning sandbox: An environment in which machine learning models can be trained, tested and their effects on the network evaluated.\nNOTE – A machine learning sandbox is designed to prevent a machine learning application from affecting the network, or to restrict the usage of certain machine learning functionalities.", "exact_source_excerpt_sha256": "b21ae4d5e3ba093c4f177d5e627533fbaba2ccf1e1079287fbc7baf847bc5d95", "exceptions_reviewed": false, "excerpt_verification_status": "verified_exact", "human_review_status": "approved", "jurisdiction": "international", "language": "en", "legal_effect": false, "limitations": [], "locator_verification_status": "verified_structural", "national_binding_status": false, "paragraph_number": null, "parallel_unit_id": null, "passage_id": "Y3172-3.2.6", "physical_pdf_page_end": 8, "physical_pdf_page_start": 8, "printed_page_label": "2", "processing_operation": null, "project_question": "What is the controlled ML sandbox concept?", "provision_citation_eligible": true, "purpose_id": "architecture_mapping", "regulated_actor": null, "regulated_service": null, "review_notes": [], "section_heading": "Terms defined in this Recommendation", "source_citation_eligible": true, "source_class": "technical_standard", "source_id": "ITU-T-Y3172-2019", "structural_locator": "Clause 3.2.6", "table_number": null, "verified_use_scope": ["architecture"], "version_id": "06/2019"}
{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": null, "artifact_path": "kb/sources/international/ITU_T_Y3172_2019.pdf", "artifact_sha256": "e42f9a3be3f951d3e19b9007f876f0b389c81b4693f0d8576e18185a1acfe67b", "binding_finding_eligible": false, "binding_finding_status": "requires_project_specific_applicability_review", "binding_level": "technical_standard", "clause_number": "7.4", "column": "not_applicable", "contextual_evidence_eligible": true, "exact_source_excerpt": "The ML architecture is required to support a standard method to represent ML applications, which can be translated into ML functionalities in technology-specific underlay network functions.", "exact_source_excerpt_sha256": "c17b0690cc2c0bff934f76990b44cf338a6d380c89f2110f1020ce84080ff1f0", "exceptions_reviewed": false, "excerpt_verification_status": "verified_exact", "human_review_status": "approved", "jurisdiction": "international", "language": "en", "legal_effect": false, "limitations": [], "locator_verification_status": "verified_structural", "national_binding_status": false, "paragraph_number": null, "parallel_unit_id": null, "passage_id": "Y3172-7.4-SPEC-001", "physical_pdf_page_end": 16, "physical_pdf_page_start": 16, "printed_page_label": "10", "processing_operation": null, "project_question": "How are ML applications represented declaratively?", "provision_citation_eligible": true, "purpose_id": "architecture_mapping", "regulated_actor": null, "regulated_service": null, "review_notes": [], "section_heading": "Declarative specifications", "source_citation_eligible": true, "source_class": "technical_standard", "source_id": "ITU-T-Y3172-2019", "structural_locator": "Clause 7.4, REQ-ML-SPEC-001", "table_number": null, "verified_use_scope": ["architecture"], "version_id": "06/2019"}
{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": null, "artifact_path": "kb/sources/international/ITU_T_Y3172_2019.pdf", "artifact_sha256": "e42f9a3be3f951d3e19b9007f876f0b389c81b4693f0d8576e18185a1acfe67b", "binding_finding_eligible": false, "binding_finding_status": "requires_project_specific_applicability_review", "binding_level": "technical_standard", "clause_number": "7.4", "column": "not_applicable", "contextual_evidence_eligible": true, "exact_source_excerpt": "The ML architecture is required to support ML applications to specify the sources of data, repositories of ML models, targets for output from ML models, and constraints on network resources.\nThe ML architecture is required to support the time constraints requirements of ML applications.", "exact_source_excerpt_sha256": "42c09969cac18fd59dc2b8e3f54c0901bbd7e4bc447cc0fe041cae886a6b0c42", "exceptions_reviewed": false, "excerpt_verification_status": "verified_exact", "human_review_status": "approved", "jurisdiction": "international", "language": "en", "legal_effect": false, "limitations": [], "locator_verification_status": "verified_structural", "national_binding_status": false, "paragraph_number": null, "parallel_unit_id": null, "passage_id": "Y3172-7.4-SPEC-002", "physical_pdf_page_end": 16, "physical_pdf_page_start": 16, "printed_page_label": "10", "processing_operation": null, "project_question": "Which inputs and constraints must an ML application specification express?", "provision_citation_eligible": true, "purpose_id": "architecture_mapping", "regulated_actor": null, "regulated_service": null, "review_notes": [], "section_heading": "Declarative specifications", "source_citation_eligible": true, "source_class": "technical_standard", "source_id": "ITU-T-Y3172-2019", "structural_locator": "Clause 7.4, REQ-ML-SPEC-002", "table_number": null, "verified_use_scope": ["architecture"], "version_id": "06/2019"}
{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": null, "artifact_path": "kb/sources/international/ITU_T_Y3172_2019.pdf", "artifact_sha256": "e42f9a3be3f951d3e19b9007f876f0b389c81b4693f0d8576e18185a1acfe67b", "binding_finding_eligible": false, "binding_finding_status": "requires_project_specific_applicability_review", "binding_level": "technical_standard", "clause_number": "8.1", "column": "not_applicable", "contextual_evidence_eligible": true, "exact_source_excerpt": "The following describes the nodes of an ML pipeline.\n• SRC (source): This node is the source of data that can be used as input to the ML pipeline.\n• C (collector): This node is responsible for collecting data from one or more SRC nodes.\n• PP (preprocessor): This node is responsible for cleaning data, aggregating data or performing any other preprocessing needed for the data to be in a suitable form so that the ML model can consume it.\n• M (model): This is a machine learning model, in a form which is usable in a machine learning pipeline.\n• P (policy): This node enables the application of policies to the output of the model node.\n• D (distributor): This node is responsible for identifying the SINK(s) and distributing the output of the M node to the corresponding SINK nodes.\n• SINK: This node is the target of the ML output on which it takes action.", "exact_source_excerpt_sha256": "5ecd0fd871c02446b68232752727b80e00a75d4e5fc32e904468fce3e689a286", "exceptions_reviewed": false, "excerpt_verification_status": "verified_exact", "human_review_status": "approved", "jurisdiction": "international", "language": "en", "legal_effect": false, "limitations": [], "locator_verification_status": "verified_structural", "national_binding_status": false, "paragraph_number": null, "parallel_unit_id": null, "passage_id": "Y3172-8.1-PIPELINE", "physical_pdf_page_end": 21, "physical_pdf_page_start": 20, "printed_page_label": "14–15", "processing_operation": null, "project_question": "What nodes form the mapped ML pipeline?", "provision_citation_eligible": true, "purpose_id": "architecture_mapping", "regulated_actor": null, "regulated_service": null, "review_notes": [], "section_heading": "High-level architectural components", "source_citation_eligible": true, "source_class": "technical_standard", "source_id": "ITU-T-Y3172-2019", "structural_locator": "Clause 8.1", "table_number": null, "verified_use_scope": ["architecture"], "version_id": "06/2019"}
{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": null, "artifact_path": "kb/sources/international/ITU_T_Y3172_2019.pdf", "artifact_sha256": "e42f9a3be3f951d3e19b9007f876f0b389c81b4693f0d8576e18185a1acfe67b", "binding_finding_eligible": false, "binding_finding_status": "requires_project_specific_applicability_review", "binding_level": "technical_standard", "clause_number": "8.1", "column": "not_applicable", "contextual_evidence_eligible": true, "exact_source_excerpt": "P (policy): This node enables the application of policies to the output of the model node.\nNOTE 5 – This node can be used, for example, to minimize impact when the output of machine learning is applied to a live ML underlay network. Specific rules can be put in place by a network operator to safeguard the sanity of the network, e.g., major upgrades may be done only at night time or when data traffic in the network is low.", "exact_source_excerpt_sha256": "fc2014936e7d5cd82da0f66bfb46244763f383d0f61246a1ac1f6c560d7a9a22", "exceptions_reviewed": false, "excerpt_verification_status": "verified_exact", "human_review_status": "approved", "jurisdiction": "international", "language": "en", "legal_effect": false, "limitations": [], "locator_verification_status": "verified_structural", "national_binding_status": false, "paragraph_number": null, "parallel_unit_id": null, "passage_id": "Y3172-8.1-POLICY", "physical_pdf_page_end": 21, "physical_pdf_page_start": 21, "printed_page_label": "15", "processing_operation": null, "project_question": "What does the P node do?", "provision_citation_eligible": true, "purpose_id": "architecture_mapping", "regulated_actor": null, "regulated_service": null, "review_notes": [], "section_heading": "High-level architectural components", "source_citation_eligible": true, "source_class": "technical_standard", "source_id": "ITU-T-Y3172-2019", "structural_locator": "Clause 8.1, P (policy)", "table_number": null, "verified_use_scope": ["architecture"], "version_id": "06/2019"}
{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": null, "artifact_path": "kb/sources/international/ITU_T_Y3172_2019.pdf", "artifact_sha256": "e42f9a3be3f951d3e19b9007f876f0b389c81b4693f0d8576e18185a1acfe67b", "binding_finding_eligible": false, "binding_finding_status": "requires_project_specific_applicability_review", "binding_level": "technical_standard", "clause_number": "8.1", "column": "not_applicable", "contextual_evidence_eligible": true, "exact_source_excerpt": "ML Intent is a declarative description which is used to specify an ML application. ML Intent does not specify any technology-specific network functions to be used in the ML application and provides a basis for mapping ML applications to diverse technology-specific network functions. ML Intent may use a metalanguage specific for machine learning to define ML applications.", "exact_source_excerpt_sha256": "62e75a05e75afed7f6c487696eef6bd02f13c10166f7007cd1a4dabe01368049", "exceptions_reviewed": false, "excerpt_verification_status": "verified_exact", "human_review_status": "approved", "jurisdiction": "international", "language": "en", "legal_effect": false, "limitations": [], "locator_verification_status": "verified_structural", "national_binding_status": false, "paragraph_number": null, "parallel_unit_id": null, "passage_id": "Y3172-8.1-ML-INTENT", "physical_pdf_page_end": 21, "physical_pdf_page_start": 21, "printed_page_label": "15", "processing_operation": null, "project_question": "What is ML Intent and how does it guide orchestration?", "provision_citation_eligible": true, "purpose_id": "architecture_mapping", "regulated_actor": null, "regulated_service": null, "review_notes": [], "section_heading": "High-level architectural components", "source_citation_eligible": true, "source_class": "technical_standard", "source_id": "ITU-T-Y3172-2019", "structural_locator": "Clause 8.1, MLFO NOTE 12", "table_number": null, "verified_use_scope": ["architecture"], "version_id": "06/2019"}
{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": null, "artifact_path": "kb/sources/international/ITU_T_Y3172_2019.pdf", "artifact_sha256": "e42f9a3be3f951d3e19b9007f876f0b389c81b4693f0d8576e18185a1acfe67b", "binding_finding_eligible": false, "binding_finding_status": "requires_project_specific_applicability_review", "binding_level": "technical_standard", "clause_number": "8.2", "column": "not_applicable", "contextual_evidence_eligible": true, "exact_source_excerpt": "An ML sandbox subsystem allows ML pipelines to adapt to dynamic network environments such as those of future networks including IMT-2020 where a variety of conditions may change (e.g., air interface conditions, UE position, network capabilities and resources). The ML sandbox subsystem includes ML pipeline(s) and simulated ML underlay networks, and it is managed by the MLFO according to the specifications in the ML Intent. The ML sandbox subsystem allows network operators to study the effect of ML outputs before deploying them on live ML underlay networks.", "exact_source_excerpt_sha256": "836cd6ced68c4046e01db854687454ec9b0565c1f1b10213470864e479e07538", "exceptions_reviewed": false, "excerpt_verification_status": "verified_exact", "human_review_status": "approved", "jurisdiction": "international", "language": "en", "legal_effect": false, "limitations": [], "locator_verification_status": "verified_structural", "national_binding_status": false, "paragraph_number": null, "parallel_unit_id": null, "passage_id": "Y3172-8.2-SANDBOX", "physical_pdf_page_end": 25, "physical_pdf_page_start": 24, "printed_page_label": "18–19", "processing_operation": null, "project_question": "How does the high-level architecture isolate testing before live deployment?", "provision_citation_eligible": true, "purpose_id": "architecture_mapping", "regulated_actor": null, "regulated_service": null, "review_notes": [], "section_heading": "High-level architecture", "source_citation_eligible": true, "source_class": "technical_standard", "source_id": "ITU-T-Y3172-2019", "structural_locator": "Clause 8.2, ML sandbox subsystem", "table_number": null, "verified_use_scope": ["architecture"], "version_id": "06/2019"}
{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": null, "artifact_path": "kb/sources/international/ITU_T_Y3172_2019.pdf", "artifact_sha256": "e42f9a3be3f951d3e19b9007f876f0b389c81b4693f0d8576e18185a1acfe67b", "binding_finding_eligible": false, "binding_finding_status": "requires_project_specific_applicability_review", "binding_level": "technical_standard", "clause_number": "9", "column": "not_applicable", "contextual_evidence_eligible": true, "exact_source_excerpt": "This Recommendation describes the architectural framework of machine learning which is expected to be applied in future networks including IMT-2020: therefore, general network security requirements and mechanisms in IP-based networks should be applied.\nIt is required to prevent from unauthorized access to, and data leaking from, an ML pipeline, whether or not they have a malicious intention, with implementation of mechanisms regarding authentication and authorization, external attack protection, etc.", "exact_source_excerpt_sha256": "7987db77b84f169d3510ee4507d99d2d72b07f0cb347e08ef31acff85e556658", "exceptions_reviewed": false, "excerpt_verification_status": "verified_exact", "human_review_status": "approved", "jurisdiction": "international", "language": "en", "legal_effect": false, "limitations": [], "locator_verification_status": "verified_structural", "national_binding_status": false, "paragraph_number": null, "parallel_unit_id": null, "passage_id": "Y3172-9-SECURITY", "physical_pdf_page_end": 26, "physical_pdf_page_start": 25, "printed_page_label": "19–20", "processing_operation": null, "project_question": "What security boundary applies to the ML pipeline?", "provision_citation_eligible": true, "purpose_id": "architecture_mapping", "regulated_actor": null, "regulated_service": null, "review_notes": [], "section_heading": "Security considerations", "source_citation_eligible": true, "source_class": "technical_standard", "source_id": "ITU-T-Y3172-2019", "structural_locator": "Clause 9", "table_number": null, "verified_use_scope": ["architecture"], "version_id": "06/2019"}
