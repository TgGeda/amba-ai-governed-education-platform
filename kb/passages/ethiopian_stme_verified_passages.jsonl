{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": null, "artifact_path": "kb/sources/ethiopia/ETH_STME_POLICY_FULL.pdf", "artifact_sha256": "d5a6fb50ecd5b324d5d0eb1e1cb0eabd1744acd0423ff434127b76b4835e0260", "binding_finding_eligible": false, "binding_finding_status": "requires_project_specific_applicability_review", "binding_level": "policy_context", "clause_number": null, "column": "not_applicable", "contextual_evidence_eligible": true, "exact_source_excerpt": "This background document for a national strategic policy for STME has been developed for this reason, looking at pre-school through to tertiary levels of education. This strategic policy foundational study provides support for the strategic policy to directly link and contribute to the objectives stated in the second Growth and Transformation Plan (GTPII), the fifth Education Sector Development Program (ESDP-V) and Climate Resilient Green Economy (CRGE).", "exact_source_excerpt_sha256": "ace31e9cf0bf9e5471a3b06fefb5b54219b0c502b06fa36ec2432ae7ff14b173", "exceptions_reviewed": false, "excerpt_verification_status": "verified_exact", "human_review_status": "approved", "jurisdiction": "Ethiopia", "language": "en", "legal_effect": false, "limitations": ["Formal adoption status remains unverified.", "Use as verified education-policy context, not as an independently binding national rule."], "locator_verification_status": "verified_exact", "national_binding_status": false, "paragraph_number": null, "parallel_unit_id": null, "passage_id": "STME-CONTEXT-001", "physical_pdf_page_end": 4, "physical_pdf_page_start": 4, "printed_page_label": "3", "processing_operation": null, "project_question": "Why does AMBA-GOV use the STME document?", "provision_citation_eligible": true, "purpose_id": "education_policy_context", "regulated_actor": null, "regulated_service": null, "review_notes": [], "section_heading": "Introduction", "sou