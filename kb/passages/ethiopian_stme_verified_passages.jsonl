{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": null, "artifact_path": "kb/sources/ethiopia/ETH_STME_POLICY_FULL.pdf", "artifact_sha256": "d5a6fb50ecd5b324d5d0eb1e1cb0eabd1744acd0423ff434127b76b4835e0260", "binding_finding_eligible": false, "binding_finding_status": "requires_project_specific_applicability_review", "binding_level": "policy_context", "clause_number": null, "column": "not_applicable", "contextual_evidence_eligible": true, "exact_source_excerpt": "Weaknesses – Internal negative attributes of current STME, and that are harmful in terms of achieving the country’s overarching STM objectives: Piecemeal and non-integrated interventions; gaps in terms of teachers’ and overall societal attitudes towards STME; lack of sufficient budget to expand and support regional training centres; limited capacity of experts compared to the task required for Ethiopia to excel in STME; poor experience sharing system; weak dissemination of efforts, findings and directions; no proper data and information flows from collaborative organs; poor monitoring and evaluation system.", "exact_source_excerpt_sha256": "cb55cec276ba29c50c7ecd53692b3255e52a6eb16b05233b7acf52f0af2f8d04", "exceptions_reviewed": false, "excerpt_verification_status": "verified_exact", "human_review_status": "approved", "jurisdiction": "Ethiopia", "language": "en", "legal_effect": false, "limitations": ["Formal adoption status remains unverified.", "Use as verified education-policy context, not as an independently binding national rule."], "locator_verification_status": "verified_exact", "national_binding_status": false, "paragraph_number": null, "parallel_unit_id": null, "passage_id": "STME-GAP-001", "physical_pdf_page_end": 23, "physical_pdf_page_start": 23, "printed_page_label": "22", "processing_operation": null, "project_question": "Which weaknesses justify evidence-grounded governance?", "provision_citation_e