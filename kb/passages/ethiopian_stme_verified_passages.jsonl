{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": null, "artifact_path": "kb/sources/ethiopia/ETH_STME_POLICY_FULL.pdf", "artifact_sha256": "d5a6fb50ecd5b324d5d0eb1e1cb0eabd1744acd0423ff434127b76b4835e0260", "binding_finding_eligible": false, "binding_finding_status": "requires_project_specific_applicability_review", "binding_level": "policy_context", "clause_number": null, "column": "not_applicable", "contextual_evidence_eligible": true, "exact_source_excerpt": "There is a need to establish and maintain an accurate database of STM teachers in Ethiopia. This will allow for the proper planning and management of training and for the measurement of its impact. In order to plan training that addresses teachers’ needs, the MoE/CSMASEE will undertake a needs analysis. This will include several things such as identifying gaps that require intervention and conducting gap-filling efforts.", "exact_source_excerpt_sha256": "56194b1de1103cf80186ade19bf710b514d7580805e726fd0574b0a2f4b43120", "exceptions_reviewed": false, "excerpt_verification_status": "verified_exact", "human_review_status": "approved", "jurisdiction": "Ethiopia", "language": "en", "legal_effect": false, "limitations": ["Formal adoption status remains unverified.", "Use as verified education-policy context, not as an independently binding national rule."], "locator_verification_status": "verified_exact", "national_binding_status": false, "paragraph_number": null, "parallel_unit_id": null, "passage_id": "STME-TEACHER-DATA-001", "physical_pdf_page_end": 38, "physical_pdf_page_start": 38, "printed_page_label": "37", "processing_operation": null, "project_question": "Why does the STME supporting document call for teacher-competence evidence and needs analysis?", "provision_citation_eligible": true, "purpose_id": "teacher_readiness", "regulated_actor": null, "regulated_service": null, "review_notes": [], "section_heading":