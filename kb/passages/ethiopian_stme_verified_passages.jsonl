{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": null, "artifact_path": "kb/sources/ethiopia/ETH_STME_POLICY_FULL.pdf", "artifact_sha256": "d5a6fb50ecd5b324d5d0eb1e1cb0eabd1744acd0423ff434127b76b4835e0260", "binding_finding_eligible": false, "binding_finding_status": "requires_project_specific_applicability_review", "binding_level": "policy_context", "clause_number": null, "column": "not_applicable", "contextual_evidence_eligible": true, "exact_source_excerpt": "Keeping the curriculum and assessment up to date is an essential component of effective STME policy and strategy. Pedagogy is also important, with the literature highlighting the importance of teacher content knowledge as well as teaching practices. These days, education literature promotes the integration of technology, content and pedagogy for the efficient and effective delivery of STM subjects. An inquiry-based, practical and relevant approach to STME teaching and learning produces the most positive outcomes.", "exact_source_excerpt_sha256": "d947e9a5876e53dd1024a5a91185181e1afc78488d478a5b82dde9f9d8e8d91f", "exceptions_reviewed": false, "excerpt_verification_status": "verified_exact", "human_review_status": "approved", "jurisdiction": "Ethiopia", "language": "en", "legal_effect": false, "limitations": ["Formal adoption status remains unverified.", "Use as verified education-policy context, not as an independently binding national rule."], "locator_verification_status": "verified_exact", "national_binding_status": false, "paragraph_number": null, "parallel_unit_id": null, "passage_id": "STME-CURRICULUM-001", "physical_pdf_page_end": 33, "physical_pdf_page_start": 33, "printed_page_label": "32", "processing_operation": null, "project_question": "Why should the project support analytical, locally relevant learning rather than rote delivery?", "provision_citation_eligible": true, "purpose_id": "curriculum_assura