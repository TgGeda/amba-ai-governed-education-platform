, "source_citation_eligible": true, "source_class": "international_guidance", "source_id": "UNICEF-AI-CHILDREN-3.0", "structural_locator": "Requirement 8, meaningful child participation", "table_number": null, "verified_successor_identified": null, "verified_use_scope": ["child_safeguarding"], "version_id": "3.0"}
