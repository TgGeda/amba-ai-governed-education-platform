{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": null, "artifact_path": "kb/sources/international/UNICEF_AI_CHILDREN_V3_2025.pdf", "artifact_sha256": "1d218b79b894402bda57d97527ef7ea015b0642003ba582d6259b050d0a548ea", "binding_finding_eligible": false, "binding_level": "international_guidance", "clause_number": null, "column": "not_applicable", "contextual_evidence_eligible": true, "current_after_2024_25": null, "exact_source_excerpt": "Governments and businesses should explicitly address children’s privacy in AI policies and laws, which must then be applied in the design, development and deployment of AI systems. For instance, decision-makers and developers should adhere to the principles of purpose-specific and minimal data collection and processing to respect children’s privacy. Similarly, there should not be “invisible” data processing. Children’s data can also be kept for the shortest period feasible, so that data collected from/about a child does not follow them into adulthood.", "exact_source_excerpt_sha256": "6a83b1e733d1e6a9a07670c691d664afb23a8eea0daeb37567a619fe7a022e9d", "exceptions_reviewed": false, "excerpt_verification_status": "source_derived", "historical_qualification_required": false, "human_review_status": "approved", "jurisdiction": "international", "language": "en", "legal_effect": false, "limitations": ["Nonbinding international guidance; does not independently establish an Ethiopian legal violation."], "locator_verification_status": "verified_structural", "national_binding_status": false, "paragraph_number": null, "parallel_unit_id": null, "passage_id": "UNICEF-PRIVACY-BY-DESIGN", "physical_pdf_page_end": 25, "physical_pdf_page_start": 25, "printed_page_label": "23", "processing_operation": null, "project_question": "Why minimize and limit retention of learner data?", "provision_citation_eligible": false, "purpose_id": "child_data_governance", "regulated_actor": null, "regulated_service": null, "review_notes": [], "section_heading": "Protect children’s data and privacy", "source_citation_eligible": true, "source_class": "international_guidance", "source_id": "UNICEF-AI-CHILDREN-3.0", "structural_locator": "Requirement 3, privacy-by-design", "table_number": null, "verified_successor_identified": null, "verified_use_scope": ["child_safeguarding"], "version_id": "3.0"}
{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": null, "artifact_path": "kb/sources/international/UNICEF_AI_CHILDREN_V3_2025.pdf", "artifact_sha256": "1d218b79b894402bda57d97527ef7ea015b0642003ba582d6259b050d0a548ea", "binding_finding_eligible": false, "binding_level": "international_guidance", "clause_number": null, "column": "not_applicable", "contextual_evidence_eligible": true, "current_after_2024_25": null, "exact_source_excerpt": "Humans must control and check any recommendations made by AI systems concerning key decisions that impact children, and the final decisions must be made by humans.", "exact_source_excerpt_sha256": "1bbb2beca6d8561159b3e300f0c884ae8752e603ec35d8ec3980bb3658779a87", "exceptions_reviewed": false, "excerpt_verification_status": "source_derived", "historical_qualification_required": false, "human_review_status": "approved", "jurisdiction": "international", "language": "en", "legal_effect": false, "limitations": ["Nonbinding international guidance; does not independently establish an Ethiopian legal violation."], "locator_verification_status": "verified_structural", "national_binding_status": false, "paragraph_number": null, "parallel_unit_id": null, "passage_id": "UNICEF-HUMAN-DECISION", "physical_pdf_page_end": 30, "physical_pdf_page_start": 30, "printed_page_label": "28", "processing_operation": null, "project_question": "Why are consequential decisions kept under human control?", "provision_citation_eligible": false, "purpose_id": "human_oversight", "regulated_actor": null, "regulated_service": null, "review_notes": [], "section_heading": "Transparency, explainability and accountability", "source_citation_eligible": true, "source_class": "international_guidance", "source_id": "UNICEF-AI-CHILDREN-3.0", "structural_locator": "Requirement 5, human control of key decisions", "table_number": null, "verified_successor_identified": null, "verified