{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": null, "artifact_path": "kb/sources/international/UNICEF_AI_CHILDREN_V3_2025.pdf", "artifact_sha256": "1d218b79b894402bda57d97527ef7ea015b0642003ba582d6259b050d0a548ea", "binding_finding_eligible": false, "binding_level": "international_guidance", "clause_number": null, "column": "not_applicable", "contextual_evidence_eligible": true, "current_after_2024_25": null, "exact_source_excerpt": "UNICEF recommends that governments and other authorities, as well as business stakeholders that design, develop, deploy or use AI systems, meet these ten requirements: 1. Ensure regulatory frameworks, oversight and compliance for child-centred AI; 2. Ensure safety for children; 3. Protect children’s data and privacy; 4. Ensure non-discrimination and fairness for children; 5. Provide transparency, explainability and accountability for children; 6. Respect human and child rights through responsible AI practice; 7. Support children’s best interests, development and well-being; 8. Ensure inclusion of and for children; 9. Prepare and skill children for present and future developments in AI; 10. Create an enabling environment for child-centred AI.", "exact_source_excerpt_sha256": "d1986bc86f8acde101f35e2c3d0b551b64d1311f9e00ef06664d3c425b87cdf5", "exceptions_reviewed": false, "excerpt_verification_status": "source_derived", "historical_qualification_required": false, "human_review_status": "approved", "jurisdiction": "international", "language": "en", "legal_effect": false, "limitations": ["Nonbinding international guidance; does not independently establish an Ethiopian legal violation."], "locator_verification_status": "verified_structural", "national_binding_status": false, "paragraph_number": null, "parallel_unit_id": null, "passage_id": "UNICEF-REQ-10", "physical_pdf_page_end": 13, "physical_pdf_page_start": 13, "printed_page_label": "11", 