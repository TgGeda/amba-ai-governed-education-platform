{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": "17", "artifact_path": "kb/sources/ethiopia/ETH_PDPA_1321_2024.pdf", "artifact_sha256": "f4e1eb0c4a6948d34accc3a93dbe32010af851f6cfb7f4b17a66ba94e2df0bf6", "binding_finding_eligible": false, "binding_level": "primary_legislation", "clause_number": null, "column": "right", "contextual_evidence_eligible": true, "exact_source_excerpt": "Taking into account the state of the art, the nature, scope, context and purposes of processing and the risks to rights and freedoms, the controller and processor shall implement measures including pseudonymization and encryption; ongoing confidentiality, integrity, availability and resilience; timely restoration after an incident; and regular testing, assessment and evaluation of security measures.", "exact_source_excerpt_sha256": "9f3b7e06325f74950d442b2df841820a80b1843bb58e6bbce4ed698dfb9486ff", "exceptions_reviewed": false, "excerpt_verification_status": "source_derived", "human_review_status": "approved", "jurisdiction": "Ethiopia", "language": "en", "legal_effect": true, "limitations": ["Primary legislation, but project applicability is not automatic.", "English and Amharic columns remain distinct; translation equivalence is not claimed.", "Binding finding requires explicit actor, operation, date, exceptions, legal review and activation decision."], "locator_verification_status": "verified_exact", "national_binding_status": true, "official_translation_verified": false, "paragraph_number": null, "parallel_unit_id": "PDPA-PAGE-25", "passage_id": "PDPA-A17-SECURITY", "physical_pdf_page_end": 25, "physical_pdf_page_start": 25, "printed_page_label": "15643", "processing_operation": "security of processing", "project_question": "Which security controls are required?", "provision_citation_eligible": false, "purpose_id": "data_protection_legal_analysis", "regulated_actor": null, "regulated_servi