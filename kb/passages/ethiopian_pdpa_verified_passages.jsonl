{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": "22", "artifact_path": "kb/sources/ethiopia/ETH_PDPA_1321_2024.pdf", "artifact_sha256": "f4e1eb0c4a6948d34accc3a93dbe32010af851f6cfb7f4b17a66ba94e2df0bf6", "binding_finding_eligible": false, "binding_level": "primary_legislation", "clause_number": null, "column": "right", "contextual_evidence_eligible": true, "exact_source_excerpt": "Every data controller or data processor shall ensure the storage, on a server or data center located in Ethiopia, of personal data collected or obtained locally. Cross-border transfer of sensitive personal data shall require the prior approval of the Authority.", "exact_source_excerpt_sha256": "eeee2680c650a6da2ab8d8085d97b44c3c7086452dd1c50d4e5c0705e62d19bb", "exceptions_reviewed": false, "excerpt_verification_status": "source_derived", "human_review_status": "approved", "jurisdiction": "Ethiopia", "language": "en", "legal_effect": true, "limitations": ["Primary legislation, but project applicability is not automatic.", "English and Amharic columns remain distinct; translation equivalence is not claimed.", "Binding finding requires explicit actor, operation, date, exceptions, legal review and activation decision."], "locator_verification_status": "verified_exact", "national_binding_status": true, "official_translation_verified": false, "paragraph_number": null, "parallel_unit_id": "PDPA-PAGE-29", "passage_id": "PDPA-A22-SOVEREIGNTY", "physical_pdf_page_end": 29, "physical_pdf_page_start": 29, "printed_page_label": "15647", "processing_operation": "storage and cross-border transfer", "project_question": "Where must locally collected personal data be stored?", "provision_citation_eligible": false, "purpose_id": "data_protection_legal_analysis", "regulated_actor": null, "regulated_service": null, "review_notes": [], "section_heading": "Data Sovereignty", "source_citation_eligible": true, "source