{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": "47", "artifact_path": "kb/sources/ethiopia/ETH_PDPA_1321_2024.pdf", "artifact_sha256": "f4e1eb0c4a6948d34accc3a93dbe32010af851f6cfb7f4b17a66ba94e2df0bf6", "binding_finding_eligible": false, "binding_level": "primary_legislation", "clause_number": null, "column": "right", "contextual_evidence_eligible": true, "exact_source_excerpt": "Where processing operations may result in a risk to the rights and freedoms of data subjects by virtue of their nature, scope, context and purposes, every controller or processor shall, prior to processing, carry out an assessment of the impact of the envisaged processing operations on personal data protection. This includes systematic and extensive evaluation based on automated processing, including profiling, where decisions produce legal effects or significantly affect the individual.", "exact_source_excerpt_sha256": "5f5352afeec18ba58cb59ebc4d42680a1a0627e46f51f3dbe1f4a1e198ca8141", "exceptions_reviewed": false, "excerpt_verification_status": "source_derived", "human_review_status": "approved", "jurisdiction": "Ethiopia", "language": "en", "legal_effect": true, "limitations": ["Primary legislation, but project applicability is not automatic.", "English and Amharic columns remain distinct; translation equivalence is not claimed.", "Binding finding requires explicit actor, operation, date, exceptions, legal review and activation decision."], "locator_verification_status": "verified_exact", "national_binding_status": true, "official_translation_verified": false, "paragraph_number": null, "parallel_unit_id": "PDPA-PAGE-49", "passage_id": "PDPA-A47-DPIA", "physical_pdf_page_end": 49, "physical_pdf_page_start": 49, "printed_page_label": "15667", "processing_operation": "high-risk automated processing", "project_question": "When is a data protection impact assessment required?", "provision_citati