{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": "2", "artifact_path": "kb/sources/ethiopia/ETH_PDPA_1321_2024.pdf", "artifact_sha256": "f4e1eb0c4a6948d34accc3a93dbe32010af851f6cfb7f4b17a66ba94e2df0bf6", "binding_finding_eligible": false, "binding_level": "primary_legislation", "clause_number": null, "column": "right", "contextual_evidence_eligible": true, "exact_source_excerpt": "“Profiling” means any form of automated processing of personal data consisting of the use of personal data to evaluate certain personal aspects relating to an individual. “Data Subject” means an individual who is the subject of personal data. “Data Controller” means any person which, alone or jointly with others, process personal data and determine the purpose and means of processing of personal data. “Data Processor” means any person other than an employee of the data controller who processes the data on behalf of the data controller.", "exact_source_excerpt_sha256": "229684d2b64bd2c6c53529cc325d8fd6052b7ea60cebcc71f3a14d512e852c28", "exceptions_reviewed": false, "excerpt_verification_status": "source_derived", "human_review_status": "approved", "jurisdiction": "Ethiopia", "language": "en", "legal_effect": true, "limitations": ["Primary legislation, but project applicability is not automatic.", "English and Amharic columns remain distinct; translation equivalence is not claimed.", "Binding finding requires explicit actor, operation, date, exceptions, legal review and activation decision."], "locator_verification_status": "verified_exact", "national_binding_status": true, "official_translation_verified": false, "paragraph_number": null, "parallel_unit_id": "PDPA-PAGE-5", "passage_id": "PDPA-A2-DEFS", "physical_pdf_page_end": 5, "physical_pdf_page_start": 5, "printed_page_label": "15623", "processing_operation": "automated processing and profiling", "project_question": "Who are the controller, processor and data subject, and what is profiling?", "provision_citation_eligible": false, "purpose_id": "data_protection_legal_analysis", "regulated_actor": null, "regulated_service": null, "review_notes": [], "section_heading": "Definitions", "source_citation_eligible": true, "source_class": "primary_legislation", "source_id": "ETH-PDPA-1321-2024", "structural_locator": "Article 2", "table_number": null, "translation_equivalence_claimed": false, "verified_use_scope": ["legal_context"], "version_id": "1321/2024"}
{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": "3", "artifact_path": "kb/sources/ethiopia/ETH_PDPA_1321_2024.pdf", "artifact_sha256": "f4e1eb0c4a6948d34accc3a93dbe32010af851f6cfb7f4b17a66ba94e2df0bf6", "binding_finding_eligible": false, "binding_level": "primary_legislation", "clause_number": null, "column": "right", "contextual_evidence_eligible": true, "exact_source_excerpt": "This Proclamation shall apply to the processing of personal data, wholly or partly, by automated means and to any processing other than by automated means where the personal data form part of a filing system or are intended to form part of a filing system. Except as otherwise provided, this Proclamation applies to a data controller or data processor if it is established in Ethiopia and the data are processed in the context of that establishment, or it uses equipment in Ethiopia for processing and has a representative established in Ethiopia.", "exact_source_excerpt_sha256": "4b80ffcdedb81a26c3410fb12d7c624fa00301dda42a0b09287b975b7dcb6c88", "exceptions_reviewed": false, "excerpt_verification_status": "source_derived", "human_review_status": "approved", "jurisdiction": "Ethiopia", "language": "en", "legal_effect": true, "limitations": ["Primary legislation, but project applicability is not automatic.", "English and Amharic columns remain distinct; translation equivalence is not claimed.", "Binding finding requires explicit actor, operation, date, exceptions, legal review and activation decision."], "locator_verification_status": "verified_exact", "national_binding_status": true, "official_translation_verified": false, "paragraph_number": null, "parallel_unit_id": "PDPA-PAGE-10", "passage_id": "PDPA-A3-SCOPE", "physical_pdf_page_end": 10, "physical_pdf_page_start": 10, "printed_page_label": "15628", "processing_operation": "processing of personal data", "project_question": "When does the Proclamation apply?", "provision_citation_eligible": false, "purpose_id": "data_protection_legal_analysis", "regulated_actor": null, "regulated_service": null, "review_notes": [], "section_heading": "Scope of Application", "source_citation_eligible": true, "source_class": "primary_legislation", "source_id": "ETH-PDPA-1321-2024", "structural_locator": "Article 3", "table_number": null, "translation_equivalence_claimed": false, "verified_use_scope": ["legal_context"], "version_id": "1321/2024"}
{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": "6", "artifact_path": "kb/sources/ethiopia/ETH_PDPA_1321_2024.pdf", "artifact_sha256": "f4e1eb0c4a6948d34accc3a93dbe32010af851f6cfb7f4b17a66ba94e2df0bf6", "binding_finding_eligible": false, "binding_level": "primary_legislation", "clause_number": null, "column": "right", "contextual_evidence_eligible": true, "exact_source_excerpt": "Personal data shall be processed lawfully, fairly and in a transparent manner; obtained only for explicit, specified and lawful purposes; adequate, relevant and not excessive; accurate and kept up to date; kept no longer than necessary; processed in a manner that ensures integrity, confidentiality and security; and processed in a manner that ensures sovereignty of the data.", "exact_source_excerpt_sha256": "53493687ebc4f4ad9f91dca00ddc36e53acedf8af93442c00e3eea5bd3d00adf", "exceptions_reviewed": false, "excerpt_verification_status": "source_derived", "human_review_status": "approved", "jurisdiction": "Ethiopia", "language": "en", "legal_effect": true, "limitations": ["Primary legislation, but project applicability is not automatic.", "English and Amharic columns remain distinct; translation equivalence is not claimed.", "Binding finding requires explicit actor, operation, date, exceptions, legal review and activation decision."], "locator_verification_status": "verified_exact", "national_binding_status": true, "official_translation_verified": false, "paragraph_number": null, "parallel_unit_id": "PDPA-PAGE-14", "passage_id": "PDPA-A6-PRINCIPLES", "physical_pdf_page_end": 14, "physical_pdf_page_start": 14, "printed_page_label": "15632", "processing_operation": "collection, storage, use and deletion", "project_question": "What processing principles govern AMBA-GOV?", "provision_citation_eligible": false, "purpose_id": "data_protection_legal_analysis", "regulated_actor": null, "regulated_service": null, "review_notes": [], "section_heading": "Principles", "source_citation_eligible": true, "source_class": "primary_legislation", "source_id": "ETH-PDPA-1321-2024", "structural_locator": "Article 6", "table_number": null, "translation_equivalence_claimed": false, "verified_use_scope": ["legal_context"], "version_id": "1321/2024"}
{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": "8", "artifact_path": "kb/sources/ethiopia/ETH_PDPA_1321_2024.pdf", "artifact_sha256": "f4e1eb0c4a6948d34accc3a93dbe32010af851f6cfb7f4b17a66ba94e2df0bf6", "binding_finding_eligible": false, "binding_level": "primary_legislation", "clause_number": null, "column": "right", "contextual_evidence_eligible": true, "exact_source_excerpt": "Personal data should be processed on the basis of consent given prior to commencement of processing. For consent to be valid, it must be free, informed, specific, clear and require an active action from the data subject. The data subject may withdraw consent at any time. The request for consent shall be clearly distinguishable and separate from other matters and cannot be bundled with other terms and conditions.", "exact_source_excerpt_sha256": "0c36b8c4f2b9e2acda8ca936eca5820cdd48b30d792581bd5e65caaeb800ce02", "exceptions_reviewed": false, "excerpt_verification_status": "source_derived", "human_review_status": "approved", "jurisdiction": "Ethiopia", "language": "en", "legal_effect": true, "limitations": ["Primary legislation, but project applicability is not automatic.", "English and Amharic columns remain distinct; translation equivalence is not claimed.", "Binding finding requires explicit actor, operation, date, exceptions, legal review and activation decision."], "locator_verification_status": "verified_exact", "national_binding_status": true, "official_translation_verified": false, "paragraph_number": null, "parallel_unit_id": "PDPA-PAGE-16", "passage_id": "PDPA-A8-CONSENT", "physical_pdf_page_end": 16, "physical_pdf_page_start": 16, "printed_page_label": "15634", "processing_operation": "consent-based processing", "project_question": "What makes consent valid?", "provision_citation_eligible": false, "purpose_id": "data_protection_legal_analysis", "regulated_actor": null, "regulated_service": null, "review_notes": [], "section_heading": "Conditions for Consent", "source_citation_eligible": true, "source_class": "primary_legislation", "source_id": "ETH-PDPA-1321-2024", "structural_locator": "Article 8", "table_number": null, "translation_equivalence_claimed": false, "verified_use_scope": ["legal_context"], "version_id": "1321/2024"}
{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": "11", "artifact_path": "kb/sources/ethiopia/ETH_PDPA_1321_2024.pdf", "artifact_sha256": "f4e1eb0c4a6948d34accc3a93dbe32010af851f6cfb7f4b17a66ba94e2df0bf6", "binding_finding_eligible": false, "binding_level": "primary_legislation", "clause_number": null, "column": "right", "contextual_evidence_eligible": true, "exact_source_excerpt": "Personal data of a minor shall be processed in a manner that protects and advances the rights and best interests of the minor. The data controller shall bear the burden of proof. Processing is lawful where consent is given or authorized by the parent, guardian or tutor, or processing is necessary to the minor’s vitally important interest.", "exact_source_excerpt_sha256": "ae33de5e7f95ebe8d19c625b092355793d679571ce1ac0f0cc067d378296359d", "exceptions_reviewed": false, "excerpt_verification_status": "source_derived", "human_review_status": "approved", "jurisdiction": "Ethiopia", "language": "en", "legal_effect": true, "limitations": ["Primary legislation, but project applicability is not automatic.", "English and Amharic columns remain distinct; translation equivalence is not claimed.", "Binding finding requires explicit actor, operation, date, exceptions, legal review and activation decision."], "locator_verification_status": "verified_exact", "national_binding_status": true, "official_translation_verified": false, "paragraph_number": null, "parallel_unit_id": "PDPA-PAGE-19", "passage_id": "PDPA-A11-MINOR", "physical_pdf_page_end": 19, "physical_pdf_page_start": 19, "printed_page_label": "15637", "processing_operation": "processing minors personal data", "project_question": "What conditions apply to processing a minor’s data?", "provision_citation_eligible": false, "purpose_id": "data_protection_legal_analysis", "regulated_actor": null, "regulated_service": null, "review_notes": [], "section_heading": "Processing of Personal Data of a Minor", "source_citation_eligible": true, "source_class": "primary_legislation", "source_id": "ETH-PDPA-1321-2024", "structural_locator": "Article 11", "table_number": null, "translation_equivalence_claimed": false, "verified_use_scope": ["legal_context"], "version_id": "1321/2024"}
{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": "11", "artifact_path": "kb/sources/ethiopia/ETH_PDPA_1321_2024.pdf", "artifact_sha256": "f4e1eb0c4a6948d34accc3a93dbe32010af851f6cfb7f4b17a66ba94e2df0bf6", "binding_finding_eligible": false, "binding_level": "primary_legislation", "clause_number": null, "column": "right", "contextual_evidence_eligible": true, "exact_source_excerpt": "Processing personal data of a minor for the purposes of marketing, profiling, or merging of profiles shall not be allowed.", "exact_source_excerpt_sha256": "87dddfb911423677725ba1661db5b9fb692f2aa5467baca8818935b788d940ca", "exceptions_reviewed": false, "excerpt_verification_status": "source_derived", "human_review_status": "approved", "jurisdiction": "Ethiopia", "language": "en", "legal_effect": true, "limitations": ["Primary legislation, but project applicability is not automatic.", "English and Amharic columns remain distinct; translation equivalence is not claimed.", "Binding finding requires explicit actor, operation, date, exceptions, legal review and activation decision."], "locator_verification_status": "verified_exact", "national_binding_status": true, "official_translation_verified": false, "paragraph_number": null, "parallel_unit_id": "PDPA-PAGE-20", "passage_id": "PDPA-A11-NO-PROFILING", "physical_pdf_page_end": 20, "physical_pdf_page_start": 20, "printed_page_label": "15638", "processing_operation": "marketing, profiling or profile merging", "project_question": "Can minors be profiled or targeted for marketing?", "provision_citation_eligible": false, "purpose_id": "data_protection_legal_analysis", "regulated_actor": null, "regulated_service": null, "review_notes": [], "section_heading": "Processing of Personal Data of a Minor", "source_citation_eligible": true, "source_class": "primary_legislation", "source_id": "ETH-PDPA-1321-2024", "structural_locator": "Article 11", "table_numb