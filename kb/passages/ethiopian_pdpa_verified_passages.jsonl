{"applicability_status": "unresolved", "applicable_effective_date": null, "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": "47", "artifact_path": "kb/sources/ethiopia/ETH_PDPA_1321_2024.pdf", "artifact_sha256": "f4e1eb0c4a6948d34accc3a93dbe32010af851f6cfb7f4b17a66ba94e2df0bf6", "binding_finding_eligible": false, "binding_level": "primary_legislation", "clause_number": null, "column": "right", "contextual_evidence_eligible": true, "exact_source_excerpt": "An assessment shall include a systematic description of the envisaged processing and purpose; an assessment of necessity and proportionality; an assessment of risks to rights and freedoms; and the measures, safeguards and security mechanisms envisaged to address the risks and demonstrate compliance.", "exact_source_excerpt_sha256": "208c0ee738c079f9d3bb2ce1362f65c2d5f642248fce393e37d1dea9fcad0ee1", "exceptions_reviewed": false, "excerpt_verification_status": "source_derived", "human_review_status": "approved", "jurisdiction": "Ethiopia", "language": "en", "legal_effect": true, "limitations": ["Primary legislation, but project applicability is not automatic.", "English and Amharic columns remain distinct; translation equivalence is not claimed.", "Binding finding requires explicit actor, operation, date, exceptions, legal review and activation decision."], "locator_verification_status": "verified_exact", "national_binding_status": true, "official_translation_verified": false, "paragraph_number": null, "parallel_unit_id": "PDPA-PAGE-50", "passage_id": "PDPA-A47-DPIA-CONTENT", "physical_pdf_page_end": 50, "physical_pdf_page_start": 50, "printed_page_label": "15668", "processing_operation": "data protection impact assessment", "project_question": "What must the impact assessment contain?", "provision_citation_eligible": false, "purpose_id": "data_protection_legal_analysis", "regulated_actor": null, "regulated_service": null, "review_notes": [], "section_heading": "Data Protection Impact Assessment