{"applicability_status": "unresolved", "applicable_effective_date": "2021-07-09", "approval_record_id": "AMBA-GOV-ACADEMIC-REVIEW-001", "article_number": null, "artifact_path": "kb/sources/ethiopia/ETH_ECA_QOS_794_2021.pdf", "artifact_sha256": "3c23ba0cfeca1f0fbdf724da211164fb8bbbec75945f16d9740cb112342ea449", "binding_finding_eligible": false, "binding_finding_status": "requires_project_specific_applicability_review", "binding_level": "directive", "clause_number": null, "column": "not_applicable", "contextual_evidence_eligible": true, "exact_source_excerpt": "Latency. Definition: The duration of time it takes, in milliseconds (ms), for a data packet to reach the receiving endpoint after being transmitted from the sending end-point. Formula: Latency (ping roundtrip) = t packet received − t packet sent [ms]. Targets: Urban <80 ms for local target server and xDSL; Rural <50 ms for local target server and xDSL. Urban <25 ms for local target server and FTTH; Rural <50 ms for local target server and FTTH.", "exact_source_excerpt_sha256": "226cda57e579fad4a2cf6700f0f7f42041788df2a5dd00afcf3e4702dde9ca61", "exceptions_reviewed": false, "excerpt_verification_status": "verified_exact", "human_review_status": "approved", "jurisdiction": "Ethiopia", "language": "en", "legal_effect": true, "limitations": ["Binding technical use requires confirmation that AMBA-GOV is within the regulated actor, service, technology, locality and measurement scope.", "Human technical validation and applicability review remain required."], "locator_verification_status": "verified_exact", "measurement_method": "Ping roundtrip to local target server", "national_binding_status": true, "paragraph_number": null, "parallel_unit_id": null, "passage_id": "ECA-T3-LATENCY", "physical_pdf_page_end": 16, "physical_pdf_page_start": 16, "printed_page_label": "15", "processing_operation": null, "project_question": "Which fixed broadband latency targets apply by access technology and locality?", "provision_citation_eligible": true, "purpose_id": "broadband_threshold", "regulated_actor": null, "regulated_service": "Fixed Broadband Internet Service", "review_notes": [], "section_heading": "Fixed Broadband Internet Service", "source_citation_eligible": true, "source_class": "directive", "source_id": "ETH-ECA-QOS-794-2021", "structural_locator": "Annex I, Table 3, Latency", "table_conditions_verified": true, "table_headers_verified": true, "table_number": "3", "verified_unit": "ms", "verified_use_scope": ["technical_context"], "version_id": "794/2021"}
