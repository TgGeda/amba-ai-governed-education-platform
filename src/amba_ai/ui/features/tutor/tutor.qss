#AmbaTutorWidgetUI {
    background-color: #070B14;
    color: #F8FAFC;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
    font-size: 10pt;
}

#AmbaTutorWidgetUI QToolBar#tutorToolbar {
    background-color: #0B1324;
    border: 1px solid #1E293B;
    border-radius: 10px;
    padding: 8px;
    spacing: 8px;
}

#AmbaTutorWidgetUI QLabel#controlRibbonLabel {
    color: #94A3B8;
    font-size: 9pt;
    font-weight: 600;
}

#AmbaTutorWidgetUI QComboBox,
#AmbaTutorWidgetUI QSpinBox,
#AmbaTutorWidgetUI QLineEdit {
    background-color: #111C33;
    border: 1px solid #223455;
    border-radius: 6px;
    padding: 6px 12px;
    color: #F8FAFC;
    selection-background-color: #0284C7;
    min-height: 26px;
}

#AmbaTutorWidgetUI QComboBox:hover,
#AmbaTutorWidgetUI QSpinBox:hover,
#AmbaTutorWidgetUI QLineEdit:focus {
    border-color: #38BDF8;
    background-color: #14223E;
}

#AmbaTutorWidgetUI QPushButton {
    background-color: #131E35;
    border: 1px solid #233554;
    border-radius: 6px;
    padding: 7px 14px;
    color: #E2E8F0;
    font-weight: 600;
    min-height: 26px;
}

#AmbaTutorWidgetUI QPushButton:hover {
    background-color: #1C2D4F;
    border-color: #38BDF8;
    color: #FFFFFF;
}

#AmbaTutorWidgetUI QPushButton[priority="primary"],
#AmbaTutorWidgetUI QPushButton#askButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0D9488, stop:1 #14B8A6);
    border: 1px solid #2DD4BF;
    color: #031018;
    font-weight: 700;
    padding: 7px 18px;
}

#AmbaTutorWidgetUI QPushButton[priority="primary"]:hover,
#AmbaTutorWidgetUI QPushButton#askButton:hover {
    background-color: #14B8A6;
    color: #000000;
}

#AmbaTutorWidgetUI QPushButton[variant="secondary"],
#AmbaTutorWidgetUI QPushButton#clearChatButton {
    background-color: #1E293B;
    border: 1px solid #334155;
    color: #F8FAFC;
}

#AmbaTutorWidgetUI QPushButton#tutorPromptChip {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 12px;
    color: #94A3B8;
    padding: 4px 10px;
    font-size: 8.5pt;
    font-weight: 600;
}

#AmbaTutorWidgetUI QPushButton#tutorPromptChip:hover {
    background-color: #1E293B;
    color: #38BDF8;
    border-color: #38BDF8;
}

#AmbaTutorWidgetUI QPushButton#tutorActionChip {
    background-color: #131E33;
    border: 1px solid #223455;
    border-radius: 4px;
    color: #94A3B8;
    padding: 3px 8px;
    font-size: 8pt;
    font-weight: 600;
}

#AmbaTutorWidgetUI QPushButton#tutorActionChip:hover {
    background-color: #1A2B48;
    color: #38BDF8;
    border-color: #38BDF8;
}

#AmbaTutorWidgetUI QTabWidget::pane {
    border: 1px solid #1E293B;
    border-radius: 10px;
    background-color: #090E1B;
}

#AmbaTutorWidgetUI QTabBar::tab {
    background-color: #0E1626;
    color: #94A3B8;
    border: 1px solid #1E293B;
    border-bottom: none;
    padding: 9px 20px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 600;
}

#AmbaTutorWidgetUI QTabBar::tab:hover {
    background-color: #15223A;
    color: #F8FAFC;
}

#AmbaTutorWidgetUI QTabBar::tab:selected {
    background-color: #090E1B;
    color: #2DD4BF;
    border-color: #0D9488;
    border-bottom: 3px solid #2DD4BF;
}

#AmbaTutorWidgetUI QLabel#tutorGroundingBadge {
    background-color: #081D26;
    border: 1px solid #0D9488;
    border-left: 4px solid #2DD4BF;
    border-radius: 6px;
    padding: 6px 12px;
    color: #5EEAD4;
    font-weight: 600;
    font-size: 9pt;
}

#AmbaTutorWidgetUI QFrame#tutorUserBubble {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-left: 4px solid #0284C7;
    border-radius: 10px;
}

#AmbaTutorWidgetUI QFrame#tutorAiResponseCard {
    background-color: #0A1222;
    border: 1px solid #182845;
    border-left: 4px solid #14B8A6;
    border-radius: 10px;
}

#AmbaTutorWidgetUI QLabel#studentAvatarBadge {
    background-color: #0284C7;
    color: #FFFFFF;
    font-size: 8pt;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
}

#AmbaTutorWidgetUI QLabel#aiAvatarBadge {
    background-color: #0D9488;
    color: #04141A;
    font-size: 8pt;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
}

#AmbaTutorWidgetUI QLabel#studentTitleLabel {
    color: #38BDF8;
    font-size: 10pt;
    font-weight: 700;
}

#AmbaTutorWidgetUI QLabel#aiTitleLabel {
    color: #2DD4BF;
    font-size: 10pt;
    font-weight: 700;
}

#AmbaTutorWidgetUI QLabel#modelIndicatorBadge {
    background-color: #101F3B;
    color: #7DD3FC;
    border: 1px solid #1E3A8A;
    border-radius: 3px;
    padding: 1px 6px;
    font-size: 7.5pt;
    font-weight: 700;
}

#AmbaTutorWidgetUI QLabel#timestampLabel {
    color: #64748B;
    font-size: 8pt;
}

#AmbaTutorWidgetUI QLabel#messageBodyText {
    color: #E2E8F0;
    font-size: 10.5pt;
    line-height: 1.6;
}

#AmbaTutorWidgetUI QFrame#tutorTakeawaysBox {
    background-color: #070D18;
    border: 1px solid #13223A;
    border-radius: 6px;
}

#AmbaTutorWidgetUI QLabel#takeawayBullet {
    color: #F59E0B;
    font-size: 9pt;
}

#AmbaTutorWidgetUI QLabel#takeawayPoint {
    color: #CBD5E1;
    font-size: 10pt;
}

#AmbaTutorWidgetUI QLabel#sourceCitationPill {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 4px;
    color: #94A3B8;
    font-size: 8pt;
    padding: 2px 6px;
}

#AmbaTutorWidgetUI QFrame#tutorInputContainer {
    background-color: #0B1324;
    border: 1px solid #1E293B;
    border-radius: 10px;
}

#AmbaTutorWidgetUI QFrame#interactiveTerminalBlock {
    background-color: #050811;
    border: 1px solid #1B2944;
    border-radius: 8px;
}

#AmbaTutorWidgetUI QFrame#terminalHeader {
    background-color: #0D1628;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom: 1px solid #1B2944;
}

#AmbaTutorWidgetUI QLabel#terminalTitle {
    color: #94A3B8;
    font-size: 8.5pt;
    font-weight: 600;
}

#AmbaTutorWidgetUI QLabel#terminalLangBadge {
    background-color: #1E293B;
    color: #2DD4BF;
    border: 1px solid #334155;
    border-radius: 3px;
    padding: 1px 6px;
    font-size: 7.5pt;
    font-weight: 800;
}

#AmbaTutorWidgetUI QPushButton#terminalCopyBtn {
    background-color: #16243D;
    border: 1px solid #243B66;
    border-radius: 4px;
    color: #E2E8F0;
    font-size: 8pt;
    font-weight: 600;
    padding: 2px 10px;
    min-height: 18px;
}

#AmbaTutorWidgetUI QPushButton#terminalCopyBtn:hover {
    background-color: #0D9488;
    color: #FFFFFF;
    border-color: #2DD4BF;
}

#AmbaTutorWidgetUI QTextBrowser#terminalCodeViewer {
    background-color: #050811;
    border: none;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

#AmbaTutorWidgetUI QTreeView#sourcesTree {
    background-color: #090E1B;
    color: #E2E8F0;
    border: 1px solid #1E293B;
    border-radius: 8px;
    alternate-background-color: #0E1729;
}

#AmbaTutorWidgetUI QTreeView::item:selected {
    background-color: #0D9488;
    color: #04141A;
    font-weight: 700;
}

#AmbaTutorWidgetUI QTextBrowser#tutorOperationLog {
    background-color: #050811;
    color: #93C5FD;
    border: 1px solid #1E293B;
    border-radius: 8px;
    padding: 12px;
}

#AmbaTutorWidgetUI QLabel#tutorStatusLabel {
    background-color: #081B2B;
    border: 1px solid #0284C7;
    border-radius: 6px;
    padding: 8px 12px;
    color: #38BDF8;
    font-weight: 700;
}

#AmbaTutorWidgetUI QLabel#tutorBottomStatus {
    color: #64748B;
    font-size: 9pt;
}

#AmbaTutorWidgetUI QProgressBar {
    background-color: #0F172A;
    border: none;
    border-radius: 4px;
}

#AmbaTutorWidgetUI QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0284C7, stop:1 #14B8A6);
    border-radius: 4px;
}