#AmbaStudyWidgetUI {
    background-color: #070B14;
    color: #F8FAFC;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
    font-size: 10pt;
}

#AmbaStudyWidgetUI QToolBar#studyToolbar {
    background-color: #0B1324;
    border: 1px solid #1E293B;
    border-radius: 10px;
    padding: 8px;
    spacing: 8px;
}

#AmbaStudyWidgetUI QLabel#controlRibbonLabel {
    color: #94A3B8;
    font-size: 9pt;
    font-weight: 600;
}

#AmbaStudyWidgetUI QComboBox,
#AmbaStudyWidgetUI QSpinBox,
#AmbaStudyWidgetUI QLineEdit {
    background-color: #111C33;
    border: 1px solid #223455;
    border-radius: 6px;
    padding: 6px 12px;
    color: #F8FAFC;
    selection-background-color: #0284C7;
    min-height: 26px;
}

#AmbaStudyWidgetUI QComboBox:hover,
#AmbaStudyWidgetUI QSpinBox:hover,
#AmbaStudyWidgetUI QLineEdit:focus {
    border-color: #38BDF8;
    background-color: #14223E;
}

#AmbaStudyWidgetUI QPushButton {
    background-color: #131E35;
    border: 1px solid #233554;
    border-radius: 6px;
    padding: 7px 14px;
    color: #E2E8F0;
    font-weight: 600;
    min-height: 26px;
}

#AmbaStudyWidgetUI QPushButton:hover {
    background-color: #1C2D4F;
    border-color: #38BDF8;
    color: #FFFFFF;
}

#AmbaStudyWidgetUI QPushButton[priority="primary"],
#AmbaStudyWidgetUI QPushButton#generateStudyButton,
#AmbaStudyWidgetUI QPushButton#primaryActionButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0D9488, stop:1 #14B8A6);
    border: 1px solid #2DD4BF;
    color: #031018;
    font-weight: 700;
}

#AmbaStudyWidgetUI QPushButton[priority="primary"]:hover,
#AmbaStudyWidgetUI QPushButton#generateStudyButton:hover,
#AmbaStudyWidgetUI QPushButton#primaryActionButton:hover {
    background-color: #14B8A6;
    color: #000000;
}

#AmbaStudyWidgetUI QPushButton[variant="secondary"],
#AmbaStudyWidgetUI QPushButton#exportFlashcardsButton,
#AmbaStudyWidgetUI QPushButton#exportMcqsButton {
    background-color: #1E293B;
    border: 1px solid #334155;
    color: #F8FAFC;
}

#AmbaStudyWidgetUI QPushButton#learningCompactAction {
    background-color: #111A2E;
    border: 1px solid #1E293B;
    color: #94A3B8;
    padding: 5px 12px;
    font-size: 9pt;
}

#AmbaStudyWidgetUI QPushButton#learningCompactAction:hover {
    background-color: #182846;
    color: #F8FAFC;
    border-color: #38BDF8;
}

#AmbaStudyWidgetUI QPushButton:disabled {
    background-color: #0F172A;
    border-color: #1E293B;
    color: #475569;
}

#AmbaStudyWidgetUI QTabWidget::pane {
    border: 1px solid #1E293B;
    border-radius: 10px;
    background-color: #090E1B;
}

#AmbaStudyWidgetUI QTabBar::tab {
    background-color: #0E1626;
    color: #94A3B8;
    border: 1px solid #1E293B;
    border-bottom: none;
    padding: 9px 20px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 600;
}

#AmbaStudyWidgetUI QTabBar::tab:hover {
    background-color: #15223A;
    color: #F8FAFC;
}

#AmbaStudyWidgetUI QTabBar::tab:selected {
    background-color: #090E1B;
    color: #38BDF8;
    border-color: #0284C7;
    border-bottom: 3px solid #38BDF8;
}

#AmbaStudyWidgetUI QFrame#studyMetricsFrame {
    background-color: #0B1324;
    border: 1px solid #1E293B;
    border-radius: 10px;
}

#AmbaStudyWidgetUI QLabel#metricsPrimaryLabel {
    color: #38BDF8;
    font-weight: 700;
    font-size: 11pt;
}

#AmbaStudyWidgetUI QLabel#metricsSecondaryLabel {
    color: #94A3B8;
    font-weight: 600;
}

#AmbaStudyWidgetUI QLabel#metricsStreakLabel {
    color: #F59E0B;
    font-weight: 800;
    font-size: 10pt;
}

#AmbaStudyWidgetUI QFrame#interactiveCardSurface {
    background-color: #0D1527;
    border: 1px solid #1A2844;
    border-radius: 12px;
}

#AmbaStudyWidgetUI QLabel#conceptPillBadge {
    background-color: #101F3B;
    color: #38BDF8;
    border: 1px solid #1E3A8A;
    border-radius: 4px;
    padding: 3px 8px;
    font-size: 8pt;
    font-weight: 800;
    letter-spacing: 0.5px;
}

#AmbaStudyWidgetUI QLabel#difficultyBadge {
    background-color: #1E293B;
    color: #F59E0B;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 3px 8px;
    font-size: 8pt;
    font-weight: 700;
}

#AmbaStudyWidgetUI QLabel#ratingStatusBadge {
    background-color: #172554;
    color: #93C5FD;
    border-radius: 4px;
    padding: 3px 8px;
    font-size: 8pt;
    font-weight: 700;
}

#AmbaStudyWidgetUI QLabel#cardQuestionTitle {
    color: #F8FAFC;
    font-size: 15pt;
    font-weight: 600;
    line-height: 1.5;
}

#AmbaStudyWidgetUI QFrame#answerSurfaceFrame {
    background-color: #091322;
    border: 1px solid #1D4ED8;
    border-left: 5px solid #38BDF8;
    border-radius: 8px;
}

#AmbaStudyWidgetUI QLabel#answerHeaderTag {
    color: #38BDF8;
    font-size: 8.5pt;
    font-weight: 800;
    letter-spacing: 0.8px;
}

#AmbaStudyWidgetUI QLabel#cardAnswerText {
    color: #E2E8F0;
    font-size: 12pt;
    line-height: 1.6;
}

#AmbaStudyWidgetUI QLabel#cardSourceText {
    color: #64748B;
    font-size: 9pt;
    font-style: italic;
}

#AmbaStudyWidgetUI QFrame#interactiveTerminalBlock {
    background-color: #050811;
    border: 1px solid #1B2944;
    border-radius: 8px;
}

#AmbaStudyWidgetUI QFrame#terminalHeader {
    background-color: #0D1628;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom: 1px solid #1B2944;
}

#AmbaStudyWidgetUI QLabel#terminalTitle {
    color: #94A3B8;
    font-size: 8.5pt;
    font-weight: 600;
}

#AmbaStudyWidgetUI QLabel#terminalLangBadge {
    background-color: #1E293B;
    color: #2DD4BF;
    border: 1px solid #334155;
    border-radius: 3px;
    padding: 1px 6px;
    font-size: 7.5pt;
    font-weight: 800;
}

#AmbaStudyWidgetUI QPushButton#terminalCopyBtn {
    background-color: #16243D;
    border: 1px solid #243B66;
    border-radius: 4px;
    color: #E2E8F0;
    font-size: 8pt;
    font-weight: 600;
    padding: 2px 10px;
    min-height: 18px;
}

#AmbaStudyWidgetUI QPushButton#terminalCopyBtn:hover {
    background-color: #0D9488;
    color: #FFFFFF;
    border-color: #2DD4BF;
}

#AmbaStudyWidgetUI QTextBrowser#terminalCodeViewer {
    background-color: #050811;
    border: none;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

#AmbaStudyWidgetUI QFrame#srsRatingBar {
    background-color: #0B1324;
    border: 1px solid #1E293B;
    border-radius: 10px;
}

#AmbaStudyWidgetUI QLabel#ratingInstructionText {
    color: #94A3B8;
    font-size: 9pt;
}

#AmbaStudyWidgetUI QPushButton#ratingBtnAgain {
    background-color: #881337;
    border: 1px solid #BE123C;
    color: #FFFFFF;
}

#AmbaStudyWidgetUI QPushButton#ratingBtnAgain:hover {
    background-color: #9F1239;
}

#AmbaStudyWidgetUI QPushButton#ratingBtnHard {
    background-color: #78350F;
    border: 1px solid #D97706;
    color: #FFFFFF;
}

#AmbaStudyWidgetUI QPushButton#ratingBtnHard:hover {
    background-color: #92400E;
}

#AmbaStudyWidgetUI QPushButton#ratingBtnGood {
    background-color: #1E3A8A;
    border: 1px solid #2563EB;
    color: #FFFFFF;
}

#AmbaStudyWidgetUI QPushButton#ratingBtnGood:hover {
    background-color: #1D4ED8;
}

#AmbaStudyWidgetUI QPushButton#ratingBtnEasy {
    background-color: #064E3B;
    border: 1px solid #059669;
    color: #FFFFFF;
}

#AmbaStudyWidgetUI QPushButton#ratingBtnEasy:hover {
    background-color: #047857;
}

#AmbaStudyWidgetUI QPushButton#choiceCardButton {
    background-color: #0E1626;
    border: 1px solid #1E2C44;
    border-radius: 10px;
    text-align: left;
    min-height: 52px;
}

#AmbaStudyWidgetUI QPushButton#choiceCardButton:hover {
    background-color: #15243C;
    border-color: #38BDF8;
}

#AmbaStudyWidgetUI QPushButton#choiceCardButton:checked {
    background-color: #142848;
    border: 2px solid #38BDF8;
}

#AmbaStudyWidgetUI QPushButton#choiceCardButton[state="correct"] {
    background-color: #06392D;
    border: 2px solid #10B981;
}

#AmbaStudyWidgetUI QPushButton#choiceCardButton[state="incorrect"] {
    background-color: #4C0519;
    border: 2px solid #F43F5E;
}

#AmbaStudyWidgetUI QLabel#choicePill {
    background-color: #1E293B;
    color: #94A3B8;
    border-radius: 14px;
    font-weight: 700;
}

#AmbaStudyWidgetUI QPushButton#choiceCardButton:checked QLabel#choicePill {
    background-color: #0284C7;
    color: #FFFFFF;
}

#AmbaStudyWidgetUI QLabel#choiceText {
    color: #F8FAFC;
    font-size: 11pt;
    font-weight: 500;
}

#AmbaStudyWidgetUI QFrame#quizExplanationSurface {
    background-color: #0B1626;
    border: 1px solid #1E293B;
    border-left: 5px solid #0284C7;
    border-radius: 8px;
}

#AmbaStudyWidgetUI QLabel#explanationVerdict[status="correct"] {
    color: #34D399;
    font-size: 10pt;
    font-weight: 800;
}

#AmbaStudyWidgetUI QLabel#explanationVerdict[status="incorrect"] {
    color: #FB7185;
    font-size: 10pt;
    font-weight: 800;
}

#AmbaStudyWidgetUI QLabel#explanationBodyText {
    color: #CBD5E1;
    font-size: 10.5pt;
    line-height: 1.5;
}

#AmbaStudyWidgetUI QTreeView {
    background-color: #090E1B;
    color: #E2E8F0;
    border: 1px solid #1E293B;
    border-radius: 8px;
    alternate-background-color: #0E1729;
}

#AmbaStudyWidgetUI QTreeView::item:selected {
    background-color: #0369A1;
    color: #FFFFFF;
}

#AmbaStudyWidgetUI QTextBrowser#studyDetailsView,
#AmbaStudyWidgetUI QTextBrowser#studyOperationLog {
    background-color: #050811;
    color: #93C5FD;
    border: 1px solid #1E293B;
    border-radius: 8px;
    padding: 12px;
}

#AmbaStudyWidgetUI QLabel#studyStatusLabel {
    background-color: #081B2B;
    border: 1px solid #0284C7;
    border-radius: 6px;
    padding: 8px 12px;
    color: #38BDF8;
    font-weight: 700;
}

#AmbaStudyWidgetUI QLabel#bottomStatusLabel {
    color: #64748B;
    font-size: 9pt;
}

#AmbaStudyWidgetUI QProgressBar {
    background-color: #0F172A;
    border: none;
    border-radius: 4px;
}

#AmbaStudyWidgetUI QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0284C7, stop:1 #14B8A6);
    border-radius: 4px;
}