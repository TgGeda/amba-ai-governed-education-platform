#AmbaIngestWidgetUI {
    background-color: #020617;
    color: #E2E8F0;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 10pt;
}

#AmbaIngestWidgetUI QToolBar#ingestToolbar {
    background-color: #0F172A;
    border-bottom: 1px solid #1E293B;
    padding: 3px;
    spacing: 4px;
}

#AmbaIngestWidgetUI QPushButton {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 6px 10px;
    color: #E2E8F0;
    font-weight: 600;
    min-height: 24px;
}

#AmbaIngestWidgetUI QPushButton:hover {
    background-color: #24324A;
    border-color: #38BDF8;
    color: #FFFFFF;
}

#AmbaIngestWidgetUI QPushButton:pressed {
    background-color: #334155;
    border-color: #0D9488;
    color: #FFFFFF;
}

#AmbaIngestWidgetUI QPushButton:disabled {
    background-color: #1E293B;
    border-color: #475569;
    color: #64748B;
}

#AmbaIngestWidgetUI QPushButton[priority="primary"] {
    background-color: #14B8A6;
    border-color: #2DD4BF;
    color: #06121F;
    font-weight: 700;
}

#AmbaIngestWidgetUI QPushButton[variant="secondary"] {
    background-color: #334155;
    border-color: #475569;
    color: #E2E8F0;
}

#AmbaIngestWidgetUI QTabWidget::pane {
    border: 1px solid #1E293B;
    border-radius: 6px;
    background-color: #020617;
}

#AmbaIngestWidgetUI QTabWidget::tab-bar {
    alignment: left;
}

#AmbaIngestWidgetUI QTabBar::tab {
    background-color: #111827;
    color: #94A3B8;
    border: 1px solid #1E293B;
    border-bottom: none;
    padding: 6px 12px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

#AmbaIngestWidgetUI QTabBar::tab:hover {
    background-color: #1E293B;
    color: #F8FAFC;
}

#AmbaIngestWidgetUI QTabBar::tab:selected {
    background-color: #0F172A;
    color: #2DD4BF;
    border-color: #0D9488;
}

#AmbaIngestWidgetUI QLabel#ingestTitle {
    color: #F8FAFC;
    font-size: 16pt;
    font-weight: bold;
}

#AmbaIngestWidgetUI QLabel#ingestSubtitle {
    color: #94A3B8;
    font-size: 10.5pt;
}

#AmbaIngestWidgetUI QLabel#ingestDropHint {
    color: #E2E8F0;
    background-color: #0F172A;
    border: 1px dashed #38BDF8;
    border-radius: 6px;
    padding: 14px;
    font-weight: 600;
}

#AmbaIngestWidgetUI QTextBrowser#ingestResultView,
#AmbaIngestWidgetUI QTextBrowser#ingestOperationLog {
    background-color: #020617;
    color: #F8FAFC;
    border: 1px solid #1E293B;
    border-radius: 4px;
    padding: 8px;
}

#AmbaIngestWidgetUI QTextBrowser#ingestOperationLog {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 9pt;
    background-color: #020617;
    border: 1px solid #0D9488;
}

#AmbaIngestWidgetUI QLabel#ingestStatusLabel {
    background-color: #042F2E;
    border: 1px solid #0D9488;
    border-radius: 4px;
    padding: 6px 8px;
    color: #A7F3D0;
    font-weight: bold;
}

#AmbaIngestWidgetUI QLabel {
    color: #E2E8F0;
}

#AmbaIngestWidgetUI QProgressBar {
    height: 18px;
    text-align: center;
    border: 1px solid #334155;
    border-radius: 4px;
    color: #E2E8F0;
    background-color: #0B1120;
}

#AmbaIngestWidgetUI QProgressBar::chunk {
    background-color: #14B8A6;
    border-radius: 3px;
}