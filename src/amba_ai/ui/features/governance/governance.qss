QWidget#SubmissionDashboard { background:#f5f7fb; color:#172033; }
QFrame[card="true"] { background:white; border:1px solid #d8deea; border-radius:10px; }
QLabel[metric="true"] { font-size:24px; font-weight:700; color:#163b72; }
QLabel[boundary="true"] { background:#fff4d6; color:#674c00; border:1px solid #e8c86a; padding:8px; border-radius:6px; }
QTabWidget::pane { border:1px solid #d8deea; background:white; }
QTabBar::tab { padding:9px 14px; }
QTabBar::tab:selected { color:#0b57d0; font-weight:700; border-bottom:2px solid #0b57d0; }
QPushButton { background:#0b57d0; color:white; padding:8px 14px; border:0; border-radius:6px; }
QPushButton:disabled { background:#94a3b8; }
QPushButton:hover { background:#0846a8; }
QTreeWidget,QTableWidget,QTextBrowser,QPlainTextEdit { background:white; border:1px solid #d8deea; }
QHeaderView::section { background:#eef2f8; padding:7px; border:0; font-weight:700; }
QLineEdit,QComboBox { background:white; border:1px solid #cbd5e1; border-radius:6px; padding:7px; }
