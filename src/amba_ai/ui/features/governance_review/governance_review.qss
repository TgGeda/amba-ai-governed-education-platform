#AmbaGovernanceReviewWidgetUI { background-color:#090D16; color:#F8FAFC; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; font-size:10pt; }
#AmbaGovernanceReviewWidgetUI QFrame#reviewCard,#AmbaGovernanceReviewWidgetUI QFrame#reviewSidebar,#AmbaGovernanceReviewWidgetUI QFrame#reviewWorkspace { background-color:#0F172A; border:1px solid #1E293B; border-radius:8px; }
#AmbaGovernanceReviewWidgetUI QLabel#reviewHeaderTitle { color:#2DD4BF; font-size:13pt; font-weight:800; }
#AmbaGovernanceReviewWidgetUI QLabel#reviewHeaderSubtitle { color:#94A3B8; font-size:9pt; }
#AmbaGovernanceReviewWidgetUI QLabel#fieldTagLabel { color:#38BDF8; font-weight:700; font-size:9pt; }
#AmbaGovernanceReviewWidgetUI QLabel#fieldValueLabel { color:#E2E8F0; font-size:9.5pt; }
#AmbaGovernanceReviewWidgetUI QLabel#statusBadgeApproved { background-color:#064E3B; color:#34D399; border:1px solid #059669; border-radius:4px; padding:3px 8px; font-weight:800; }
#AmbaGovernanceReviewWidgetUI QLabel#statusBadgeRejected { background-color:#881337; color:#FDA4AF; border:1px solid #E11D48; border-radius:4px; padding:3px 8px; font-weight:800; }
#AmbaGovernanceReviewWidgetUI QLabel#statusBadgeRevoked { background-color:#4C0519; color:#FB7185; border:1px solid #BE123C; border-radius:4px; padding:3px 8px; font-weight:800; }
#AmbaGovernanceReviewWidgetUI QLabel#statusBadgePending { background-color:#78350F; color:#FCD34D; border:1px solid #D97706; border-radius:4px; padding:3px 8px; font-weight:800; }
#AmbaGovernanceReviewWidgetUI QTreeView#chunkTreeView,#AmbaGovernanceReviewWidgetUI QTextBrowser#chunkTextBrowser,#AmbaGovernanceReviewWidgetUI QTextBrowser#historyBrowser,#AmbaGovernanceReviewWidgetUI QPlainTextEdit#redactionsEditor { background-color:#020617; color:#E2E8F0; border:1px solid #334155; border-radius:6px; padding:7px; }
#AmbaGovernanceReviewWidgetUI QTreeView#chunkTreeView { alternate-background-color:#090D16; }
#AmbaGovernanceReviewWidgetUI QTreeView#chunkTreeView::item:selected { background-color:#134E4A; color:#5EEAD4; font-weight:700; }
#AmbaGovernanceReviewWidgetUI QLineEdit,#AmbaGovernanceReviewWidgetUI QComboBox { background-color:#020617; border:1px solid #334155; border-radius:6px; padding:6px 10px; color:#F8FAFC; min-height:24px; }
#AmbaGovernanceReviewWidgetUI QLineEdit:focus,#AmbaGovernanceReviewWidgetUI QComboBox:focus,#AmbaGovernanceReviewWidgetUI QPlainTextEdit:focus { border:1px solid #2DD4BF; }
#AmbaGovernanceReviewWidgetUI QPushButton { background-color:#1E293B; border:1px solid #334155; border-radius:6px; padding:7px 14px; color:#F8FAFC; font-weight:700; min-height:24px; }
#AmbaGovernanceReviewWidgetUI QPushButton:hover { background-color:#283548; border-color:#64748B; }
#AmbaGovernanceReviewWidgetUI QPushButton#btnApprove { background-color:#065F46; border:1px solid #10B981; }
#AmbaGovernanceReviewWidgetUI QPushButton#btnApproveRedacted { background-color:#0E7490; border:1px solid #06B6D4; }
#AmbaGovernanceReviewWidgetUI QPushButton#btnReject { background-color:#991B1B; border:1px solid #DC2626; }
#AmbaGovernanceReviewWidgetUI QPushButton#btnRevoke { background-color:#701A75; border:1px solid #A21CAF; }
#AmbaGovernanceReviewWidgetUI QFrame#receiptBanner { background-color:#042F2E; border:1px solid #0D9488; border-radius:6px; padding:8px; }
#AmbaGovernanceReviewWidgetUI QLabel#receiptText { color:#A7F3D0; font-family:monospace; font-weight:700; }
#AmbaGovernanceReviewWidgetUI QCheckBox { color:#FBBF24; spacing:7px; }
QSplitter::handle:horizontal { background-color:#1E293B; width:3px; margin:4px 1px; }
QSplitter::handle:horizontal:hover { background-color:#14B8A6; }
