/* Modern Glass UI QSS Theme - Inspired by Windows Fluent Design & macOS */

/* Main Window */
QMainWindow {
    background-color: rgba(255, 255, 255, 0.8);
    font-family: "SF Pro", "Segoe UI", sans-serif;
}

/* Push Button */
QPushButton {
    background-color: rgba(0, 120, 215, 0.7);
    color: white;
    border-radius: 8px;
    padding: 10px 20px;
    border: none;
    font-weight: 600;
}

QPushButton:hover {
    background-color: rgba(0, 120, 215, 0.9);
}

QPushButton:pressed {
    background-color: rgba(0, 84, 150, 0.9);
}

QMenuBar {
    background-color: #ffffff !important;
    color: #212529 !important;
    font-weight: 450 !important;
    padding: 4px 8px !important;
    border-bottom: 1px solid #adb5bd;
    font-size: 10pt !important;
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif !important;
    user-select: none;
}

QMenuBar::item {
    background-color: transparent;
    color: #212529 !important;
    font-weight: 500 !important;
    padding: 4px 8px;
    border-radius: 3px;
    outline: none;
}

QMenuBar::item:selected {
    background-color: #e9ecef !important;
    color: #0056b3 !important;
    font-weight: 450 !important;
    border-radius: 3px;
}

QMenuBar::item:pressed {
    background-color: #ced4da !important;
    color: black !important;
    font-weight: 450 !important;
    border-radius: 3px;
}

QMenuBar::item:focus {
    outline: 2px solid #0056b3;
    outline-offset: 2px;
}

QWidget > QMenuBar {
    background-color: #ffffff !important;
    color: #212529 !important;
    font-weight: 450 !important;
    padding: 4px 8px !important;
    border-bottom: 1px solid #adb5bd;
    font-size: 10pt !important;
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif !important;
}

/* Menu */
QMenu {
    background-color: rgba(255, 255, 255, 0.8);
    color: #222222;
    border: 1px solid #d0d7de;
    padding: 4px 0;
    margin: 0;
}

QMenu::item {
    padding: 4px 24px 4px 24px;
    background-color: transparent;
}

QMenu::item:selected {
    background-color: rgba(240, 240, 240, 0.8);
}

/* Tool Bar */
QToolBar {
    background-color: rgba(240, 240, 240, 0.8);
    border: none;
}

/* Status Bar */
QStatusBar {
    background-color: rgba(255, 255, 255, 0.8);
    color: #222222;
    border-top: 1px solid #d0d7de;
    padding: 2px 6px;
}

/* Scroll Bars */
QScrollBar:vertical {
    background-color: rgba(240, 240, 240, 0.8);
    width: 12px;
    margin: 16px 0 16px 0;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: rgba(0, 120, 215, 0.5);
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(0, 120, 215, 0.8);
}

QScrollBar::handle:vertical:pressed {
    background-color: rgba(0, 84, 150, 0.9);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Horizontal Scroll Bar */
QScrollBar:horizontal {
    background-color: rgba(240, 240, 240, 0.8);
    height: 12px;
    margin: 0 16px 0 16px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(0, 120, 215, 0.5);
    min-width: 20px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(0, 120, 215, 0.8);
}

QScrollBar::handle:horizontal:pressed {
    background-color: rgba(0, 84, 150, 0.9);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Line Edit */
QLineEdit {
    background-color: rgba(255, 255, 255, 0.8);
    color: #222222;
    border: 1px solid rgba(208, 215, 222, 0.8);
    border-radius: 6px;
    padding: 6px 12px;
    selection-background-color: rgba(0, 120, 215, 0.7);
    selection-color: white;
}

/* Text Edit */
QTextEdit {
    background-color: rgba(255, 255, 255, 0.8);
    color: #222222;
    border: 1px solid rgba(208, 215, 222, 0.8);
    border-radius: 6px;
    selection-background-color: rgba(0, 120, 215, 0.7);
    selection-color: white;
}

/* ComboBox */
QComboBox {
    background-color: rgba(255, 255, 255, 0.8);
    color: #222222;
    border: 1px solid rgba(208, 215, 222, 0.8);
    border-radius: 6px;
    padding: 6px 12px;
}

QComboBox:hover {
    border-color: rgba(0, 120, 215, 0.9);
}

QComboBox::drop-down {
    border-left: 1px solid rgba(208, 215, 222, 0.8);
}

QComboBox QAbstractItemView {
    background-color: rgba(255, 255, 255, 0.9);
    color: #222222;
    border: 1px solid rgba(208, 215, 222, 0.8);
    selection-background-color: rgba(0, 120, 215, 0.7);
    selection-color: white;
}

/* CheckBox */
QCheckBox {
    color: #222222;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator:unchecked {
    border: 1.5px solid rgba(0, 0, 0, 0.15);
    background-color: rgba(255, 255, 255, 0.8);
    border-radius: 4px;
}

QCheckBox::indicator:checked {
    border: 1.5px solid rgba(0, 120, 215, 0.8);
    background-color: rgba(0, 120, 215, 0.8);
    border-radius: 4px;
}

/* RadioButton */
QRadioButton {
    color: #222222;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
}

QRadioButton::indicator:unchecked {
    border: 1.5px solid rgba(0, 0, 0, 0.15);
    background-color: rgba(255, 255, 255, 0.8);
    border-radius: 9px;
}

QRadioButton::indicator:checked {
    border: 1.5px solid rgba(0, 120, 215, 0.8);
    background-color: rgba(0, 120, 215, 0.8);
    border-radius: 9px;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid rgba(208, 215, 222, 0.8);
    background-color: rgba(255, 255, 255, 0.8);
}

QTabBar::tab {
    background: rgba(240, 240, 240, 0.8);
    color: #222222;
    padding: 10px 20px;
    border: 1px solid rgba(208, 215, 222, 0.8);
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 2px;
}

QTabBar::tab:selected, QTabBar::tab:hover {
    background: rgba(0, 120, 215, 0.7);
    color: white;
}

/* ToolTip */
QToolTip {
    background-color: rgba(0, 0, 0, 0.8);
    color: white;
    border: none;
    padding: 6px;
    border-radius: 6px;
    font-weight: 600;
}