/* ===================================================================
   AmbaAI Summary Workspace QSS — Academic LMS Editorial Theme
   Tab 0: Summary Specific Outline | Tab 1: Key Concepts Specific Outline
   =================================================================== */

/* Master Application Surface */
#AmbaSummarizerWidgetUI,
QWidget#learningReadingViewport {
    background-color: #FBF7EF;
    color: #1D3323;
    font-family: "Atkinson Hyperlegible", "Lexend", "Segoe UI", "Arial", sans-serif;
}

QWidget#learningReadingColumn {
    background-color: transparent;
    min-width: 100%;
}

/* ===================================================================
   1. Compact Integrated Header Card
   =================================================================== */
QFrame#compactHeaderCard {
    background-color: #FFFDF8;
    border: 1px solid #DCC8A9;
    border-radius: 8px;
    padding: 4px 8px;
}

QLabel#learningPageTitle,
QLabel#topicTitle {
    color: #C05C46;
    font-size: 15px;
    font-weight: 900;
}

QLabel#learningMetadata {
    color: #315343;
    font-size: 11px;
    font-weight: 600;
}

/* Source Citation Badge */
QPushButton#learningSourceChip,
QLabel#sourceBadgeMuted {
    background-color: #F4E9D7;
    color: #315343;
    border: 1px solid #DCC8A9;
    border-radius: 12px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 750;
    max-height: 22px;
}

QPushButton#learningSourceChip:hover {
    background-color: #EAD7B8;
    border-color: #CDAF83;
}

QPushButton#learningSourceChip:disabled {
    background-color: #F4E9D7;
    color: #8A9A90;
    border-color: #E6D5B8;
}

/* Mastery Banner */
QFrame#learningMasteryBanner {
    background-color: transparent;
    border: none;
    padding: 0px;
}

QLabel#learningMasteryLabel {
    color: #1D3323;
    font-size: 11px;
    font-weight: 800;
}

QProgressBar#learningMasteryProgress {
    min-height: 5px;
    max-height: 5px;
    border: 1px solid #DCC8A9;
    border-radius: 2px;
    background-color: #F4E9D7;
}

QProgressBar#learningMasteryProgress::chunk {
    background-color: #C05C46;
    border-radius: 2px;
}

/* ===================================================================
   2. Control Toolbars & Action Controls
   =================================================================== */
QComboBox#summaryModeCombo,
QComboBox#summaryLanguageCombo {
    background-color: #FFFDF8;
    color: #1D3323;
    border: 1px solid #DCC8A9;
    border-radius: 6px;
    padding: 2px 8px;
    min-height: 26px;
    max-height: 28px;
    font-size: 12px;
    font-weight: 600;
}

QCheckBox {
    font-size: 12px;
    font-weight: 700;
    spacing: 5px;
}

/* Search Bar (Spans Width Gracefully) */
QFrame#learningSearchBar {
    background-color: #FFFDF8;
    border: 1px solid #DCC8A9;
    border-radius: 6px;
    min-height: 28px;
    max-height: 28px;
    min-width: 220px;
}

QLineEdit#learningSearchInput {
    background-color: transparent;
    color: #1D3323;
    border: none;
    padding: 2px 6px;
    font-size: 12px;
}

QLabel#learningSearchCount,
QLabel#learningSearchStatus {
    font-size: 11px;
    font-weight: 700;
    color: #315343;
    padding: 0 4px;
}

/* Buttons */
QPushButton#learningCompactAction,
QPushButton#learningSecondaryAction,
QPushButton#navLinkBtn {
    background-color: #FFFDF8;
    color: #1D3323;
    border: 1px solid #DCC8A9;
    border-radius: 6px;
    padding: 3px 10px;
    min-height: 26px;
    max-height: 28px;
    font-size: 12px;
    font-weight: 750;
}

QPushButton#learningCompactAction:hover,
QPushButton#learningSecondaryAction:hover,
QPushButton#navLinkBtn:hover {
    background-color: #F4E9D7;
    border-color: #CDAF83;
}

QPushButton#learningCompactAction:checked {
    background-color: #C05C46;
    color: #FFFDF8;
    border-color: #9C4533;
}

QPushButton[priority="primary"],
QPushButton#generateSummaryButton {
    background-color: #C05C46;
    color: #FFFDF8;
    border: 1px solid #9C4533;
    font-weight: 900;
    border-radius: 6px;
    padding: 3px 12px;
    min-height: 26px;
    max-height: 28px;
    font-size: 12px;
}

QPushButton[priority="primary"]:hover,
QPushButton#generateSummaryButton:hover {
    background-color: #D16850;
}

/* Floating Exit Focus Button */
QPushButton#exitFocusFloatingBtn {
    background-color: #FFFDF8;
    color: #C05C46;
    border: 2px solid #C05C46;
    border-radius: 14px;
    padding: 4px 14px;
    font-weight: 800;
    font-size: 12px;
}

QPushButton#exitFocusFloatingBtn:hover {
    background-color: #C05C46;
    color: #FFFDF8;
}

/* ===================================================================
   3. Zero-Border Editorial Reading Canvas (No Rectangle Enclosures)
   =================================================================== */

/* Accordion Section Containers */
QFrame#learningAccordionCard {
    background-color: transparent;
    border: none;
    margin-bottom: 12px;
}

/* Accordion Top Header Bar */
QFrame#learningAccordionHeader {
    background-color: transparent;
    border-bottom: 2px solid #E6D5B8;
    min-height: 28px;
}

QLabel#learningAccordionTitle {
    color: #C05C46;
    font-size: 15px;
    font-weight: 900;
}

QLabel#learningAccordionChevron {
    color: #C05C46;
    font-size: 12px;
    font-weight: 900;
}

/* Body & Rich Text Browsers — STRICTLY BORDERLESS & TRANSPARENT */
QFrame#learningAccordionBody,
QTextBrowser,
QTextBrowser#learningRichText,
QTextBrowser#sectionLearningText,
QTextBrowser#executiveSummaryText,
QTextBrowser#keyTakeawaysText,
QTextBrowser#telegramConceptBody,
QTextBrowser#telegramConceptRelevance {
    background-color: transparent !important;
    background: transparent !important;
    border: none !important;
    outline: none !important;
    padding: 0px !important;
}

/* Telegram Concept Post Items */
QFrame#telegramConceptPost {
    background-color: transparent;
    border: none;
}

QPushButton#telegramActionBtn {
    background-color: #FFFDF8;
    color: #315343;
    border: 1px solid #DCC8A9;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 700;
}

QPushButton#telegramActionBtn:hover {
    background-color: #F4E9D7;
    border-color: #C05C46;
}

/* ===================================================================
   4. Tab-Specific Tab 0 & Tab 1 Outline Sidebars (ASU / Canvas LMS)
   =================================================================== */

/* Splitters for Tab 0 (Summary) and Tab 1 (Key Concepts) */
QSplitter#summarySplitter::handle,
QSplitter#conceptExplorerSplitter::handle {
    background-color: #E6D5B8;
    width: 2px;
}

/* Tab-Specific Outline Navigation Drawer */
QFrame#documentOutlinePanel {
    background-color: #F4E9D7;
    border: 1px solid #DCC8A9;
    border-radius: 8px;
    padding: 4px;
}

QLabel#outlinePanelTitle {
    color: #315343;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.5px;
    padding: 2px 4px;
}

QPushButton#outlineToggleBtn {
    background-color: transparent;
    color: #315343;
    border: none;
    font-weight: 800;
}

QPushButton#outlineToggleBtn:hover {
    background-color: #EAD7B8;
    border-radius: 4px;
}

/* Outline List Widget — Warm Academic Theme */
QListWidget#outlineListWidget {
    background-color: transparent;
    border: none;
    outline: none;
}

QListWidget#outlineListWidget::item {
    color: #1D3323;
    font-size: 12px;
    font-weight: 650;
    padding: 6px 10px;
    border-radius: 6px;
    margin-bottom: 2px;
    background-color: transparent;
}

QListWidget#outlineListWidget::item:hover {
    background-color: #EAD7B8;
    color: #1D3323;
}

QListWidget#outlineListWidget::item:selected {
    background-color: #FFFDF8;
    color: #C05C46;
    font-weight: 900;
    border-left: 3px solid #C05C46;
    border-top: 1px solid #E6D5B8;
    border-right: 1px solid #E6D5B8;
    border-bottom: 1px solid #E6D5B8;
}

/* Header Dividers inside Tab Outlines */
QListWidget#outlineListWidget::item:disabled {
    color: #315343;
    font-size: 10px;
    font-weight: 900;
    background-color: transparent;
    padding: 8px 4px 3px 4px;
}