
QWidget#learningReadingViewport { background: {{surface_base}}; }
QWidget#learningReadingColumn { background: transparent; }
QFrame#learningHeader, QFrame#learningAccordionCard, QFrame#learningConceptInspector,
QFrame#learningEmptyState, QFrame#learningTableCard, QFrame#learningFigureCard,
QFrame#learningMasteryBanner { background: {{surface_card}}; border: 1px solid {{border_subtle}}; border-radius: 10px; }
QLabel#learningPageTitle { color: {{text_primary}}; font-size: 22px; font-weight: 800; }
QLabel#learningMetadata, QLabel#learningCaption, QLabel#learningFigureSummary,
QLabel#learningTechnicalExplanation, QLabel#learningEmptyBody { color: {{text_secondary}}; font-size: 13px; }
QPushButton#learningSourceChip { background: {{surface_muted}}; color: {{text_secondary}}; border: 1px solid {{border_subtle}}; border-radius: 12px; padding: 4px 9px; }
QFrame#learningAccordionHeader { background: {{surface_muted}}; border-top-left-radius: 9px; border-top-right-radius: 9px; }
QToolButton#learningAccordionToggle { color: {{text_primary}}; border: none; font-size: 15px; font-weight: 700; text-align: left; padding: 5px; }
QFrame#learningAccordionCard[reviewed="true"] { border-left: 4px solid {{success}}; }
QFrame#learningSearchBar { background: {{surface_card}}; border: 1px solid {{border_subtle}}; border-radius: 9px; }
QLineEdit#learningSearchInput { background: transparent; color: {{text_primary}}; border: none; padding: 7px; }
QPushButton#learningCompactAction, QPushButton#learningSecondaryAction { background: {{surface_card}}; color: {{accent_primary}}; border: 1px solid {{accent_primary}}; border-radius: 7px; padding: 6px 10px; }
QPushButton#learningConceptChip { background: {{surface_muted}}; color: {{text_primary}}; border: 1px solid {{border_subtle}}; border-radius: 8px; padding: 9px 11px; text-align: left; font-weight: 700; }
QPushButton#learningConceptChip:hover { border-color: {{accent_primary}}; }
QLabel#learningConceptTitle, QLabel#learningContentTitle, QLabel#learningEmptyTitle, QLabel#learningMasteryLabel { color: {{text_primary}}; font-size: 16px; font-weight: 800; }
QLabel#learningConceptCategory { background: #E6FFFA; color: #285E61; border: 1px solid #81E6D9; border-radius: 8px; padding: 4px 8px; }
QLabel#learningConceptDefinition, QLabel#learningConceptRelevance { color: {{text_primary}}; font-size: 14px; }
QFrame#learningTechnicalBlock { background: {{code_surface}}; border: 1px solid #26384A; border-radius: 9px; }
QLabel#learningTechnicalLabel { color: {{code_accent}}; font-weight: 800; }
QPlainTextEdit#learningCodeContent { background: {{code_surface}}; color: {{code_text}}; border: none; font-family: Consolas, "Courier New", monospace; font-size: 13px; }
QPushButton#learningCodeCopy { background: #173149; color: {{code_text}}; border: 1px solid #365B78; border-radius: 6px; padding: 5px 9px; }
QTableWidget#learningDataTable { background: {{surface_card}}; color: {{text_primary}}; gridline-color: {{border_subtle}}; alternate-background-color: {{surface_muted}}; }
QHeaderView::section { background: {{accent_primary}}; color: white; padding: 7px; border: none; font-weight: 700; }
QProgressBar#learningProgress, QProgressBar#learningMasteryProgress { min-height: 8px; max-height: 8px; border: none; border-radius: 4px; background: #E2E8F0; }
QProgressBar#learningProgress::chunk, QProgressBar#learningMasteryProgress::chunk { background: {{accent_primary}}; border-radius: 4px; }
QWidget:focus { border: 2px solid {{focus}}; }
QPushButton:disabled { color: #94A3B8; border-color: #CBD5E1; background: #F1F5F9; }
