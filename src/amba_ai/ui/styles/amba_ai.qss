QWidget {
    background-color: #0B0E14;
    color: #BAC2DE;
    font-family: "Segoe UI", -apple-system, Roboto, Helvetica, Arial, sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #07090D;
}

QLabel {
    color: #8F9BB3;
    font-weight: 500;
}

QTabWidget::pane {
    border: 1px solid #1A2138;
    background-color: #0E1220;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background-color: #111628;
    color: #717D96;
    border: 1px solid #1A2138;
    border-bottom: none;
    padding: 10px 24px;
    font-size: 12px;
    font-weight: 600;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 4px;
}

QTabBar::tab:hover {
    background-color: #171E36;
    color: #A3AED0;
}

QTabBar::tab:selected {
    background-color: #0E1220;
    color: #00BFA6;
    border: 1px solid #1A2138;
    border-bottom: 1px solid #0E1220;
    font-weight: 700;
}

QPushButton {
    background-color: #1C233D;
    color: #E2E8F0;
    border: 1px solid #293156;
    border-radius: 6px;
    padding: 8px 18px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton:hover {
    background-color: #242D4F;
    border-color: #00BFA6;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #131728;
}

QPushButton:disabled {
    background-color: #090B12;
    color: #434B65;
    border-color: #131728;
}

QPushButton[priority="primary"] {
    background-color: #00BFA6;
    color: #05060A;
    border: none;
    font-weight: 700;
    padding: 10px 22px;
}

QPushButton[priority="primary"]:hover {
    background-color: #17D2B5;
    color: #000000;
}

QPushButton[priority="primary"]:pressed {
    background-color: #009682;
}

QPushButton[priority="competition"] {
    background-color: #FF9F1C;
    color: #05060A;
    border: none;
    font-weight: 700;
    padding: 10px 22px;
}

QPushButton[priority="competition"]:hover {
    background-color: #FFAE42;
    color: #000000;
}

QPushButton[priority="competition"]:pressed {
    background-color: #E08400;
}

QPushButton[variant="secondary"] {
    background-color: #2E3A59;
    color: #E2E8F0;
    border: 1px solid #3E4E77;
}

QPushButton[variant="secondary"]:hover {
    background-color: #38476D;
    border-color: #00BFA6;
}

QPushButton[variant="danger"] {
    background-color: #FF4B5C;
    color: #FFFFFF;
    border: none;
}

QPushButton[variant="danger"]:hover {
    background-color: #FF6B7B;
}

QPushButton[variant="ghost"] {
    background-color: transparent;
    color: #BAC2DE;
    border: 1px dashed #293156;
}

QPushButton[variant="ghost"]:hover {
    background-color: #141A2D;
    border-color: #00BFA6;
}

QLineEdit, QTextEdit {
    background-color: #080A10;
    color: #EDF2F7;
    border: 1px solid #1E253F;
    border-radius: 6px;
    padding: 10px;
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #00BFA6;
}

QLineEdit[role="search"] {
    background-color: #06080D;
    border: 1px solid #1C233D;
    padding-left: 12px;
}

QLineEdit[role="chat"] {
    background-color: #090C15;
    border: 1px solid #242D4F;
    padding: 12px;
}

QTextEdit[role="content"] {
    background-color: #080A0F;
    line-height: 1.6;
    font-size: 13px;
}

QListWidget {
    background-color: #080A0F;
    border: 1px solid #1A2138;
    border-radius: 6px;
    padding: 8px;
}

QListWidget::item {
    background-color: #131726;
    color: #EDF2F7;
    border: 1px solid #1C233D;
    border-radius: 5px;
    padding: 12px;
    margin-bottom: 6px;
}

QListWidget::item:hover {
    background-color: #1A2136;
    border-color: #00BFA6;
}

QListWidget::item:selected {
    background-color: #00BFA6;
    color: #05060A;
    border-color: #00BFA6;
    font-weight: bold;
}

QProgressBar {
    border: 1px solid #1E253F;
    border-radius: 6px;
    background-color: #080A10;
    text-align: center;
    color: #FFFFFF;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: #00BFA6;
    border-radius: 5px;
}

QStatusBar {
    background-color: #07090D;
    color: #717D96;
    border-top: 1px solid #161C30;
}

QToolTip {
    background-color: #1C233D;
    color: #EDF2F7;
    border: 1px solid #00BFA6;
    border-radius: 4px;
    padding: 6px;
}

QDialog, QMessageBox, QFileDialog {
    background-color: #0E1220;
    color: #EDF2F7;
}

QScrollBar:vertical {
    border: none;
    background: #080A10;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #1C233D;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #00BFA6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
    border: none;
}

QScrollBar:horizontal {
    border: none;
    background: #080A10;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #1C233D;
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #00BFA6;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: none;
    border: none;
}

QLabel[badge="offline"] {
    background-color: #1C233D;
    color: #00BFA6;
    border: 1px solid #00BFA6;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 700;
}

QLabel[badge="safe"] {
    background-color: #142323;
    color: #0FD2B5;
    border: 1px solid #0FD2B5;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 700;
}

QLabel[badge="cloud"] {
    background-color: #2D2314;
    color: #FF9F1C;
    border: 1px solid #FF9F1C;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 700;
}

QLabel[role="status"] {
    color: #8F9BB3;
}

QLabel[role="success"] {
    color: #00BFA6;
}

QLabel[role="warning"] {
    color: #FF9F1C;
}

QLabel[role="error"] {
    color: #FF4B5C;
}