/* Base widget font and background */
QWidget {
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    font-size: 10pt;
    color: #e0e0e0;
    background-color: #2b2b2b;
    outline: none;
}

/* Main window background */
QMainWindow {
    background-color: #212121;
}

/* Toolbar style */
QToolBar {
    background-color: #3c3f41;
    border-bottom: 1px solid #4a4a4a;
    padding: 4px 8px;
    spacing: 4px;
}

/* Tool buttons */
QToolButton {
    color: #d0d0d0;
    background-color: transparent;
    border: 1px solid transparent;
    padding: 5px 8px;
    margin: 1px;
    border-radius: 4px;
    font-size: 10pt;
}

QToolButton:hover {
    background-color: #4a4a4a;
    border: 1px solid #5a5a5a;
    color: #87cefa;
}

QToolButton:pressed {
    background-color: #555555;
}

QToolButton:checked {
    background-color: #4b6eaf;
    border: 1px solid #4b6eaf;
    color: #ffffff;
}

QToolButton:disabled {
    color: #6a6a6a;
}

/* Tab widget pane */
QTabWidget::pane {
    border: 1px solid #4a4a4a;
    background-color: #2b2b2b;
}

/* Tab bar tabs */
QTabBar::tab {
    background-color: #353535;
    border: 1px solid #4a4a4a;
    color: #b0b0b0;
    padding: 8px 16px;
    min-width: 100px;
    font-size: 10pt;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    margin-right: 2px;
}

/* Selected tab */
QTabBar::tab:selected {
    /* Keep menu tab background white as requested */
    background-color: #ffffff;
    color: #007bff;
    border: 1px solid #dee2e6;
    border-bottom: 1px solid white;
    font-weight: bold;
}

/* Hovered but unselected tabs */
QTabBar::tab:!selected:hover {
    background-color: #404040;
    color: #87cefa;
    border: 1px solid #555555;
    border-bottom: none;
}

/* Close button on tabs */
QTabBar::close-button {
    image: url(:/qt-project.org/styles/commonstyle/images/standardbutton-close-inverted-16.png);
}

QTabBar::close-button:hover {
    background-color: #666666;
}

/* QPushButton */
QPushButton {
    background-color: #4b6eaf;
    border: 1px solid #4b6eaf;
    color: #ffffff;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: bold;
    min-width: 80px;
    font-size: 10pt;
}

QPushButton:hover {
    background-color: #5a86d1;
    border-color: #5a86d1;
}

QPushButton:pressed {
    background-color: #3a5a9a;
    border-color: #3a5a9a;
}

QPushButton:disabled {
    background-color: #4a4a4a;
    border-color: #5a5a5a;
    color: #808080;
}

/* List and tree views */
QListView, QTreeView {
    background-color: #313335;
    border: 1px solid #4a4a4a;
    alternate-background-color: #35383a;
    color: #d0d0d0;
    font-size: 10pt;
    padding: 4px;
    border-radius: 4px;
}

QListView::item, QTreeView::item {
    padding: 4px;
    border-radius: 3px;
}

QListView::item:selected, QTreeView::item:selected {
    background-color: #4b6eaf;
    color: #ffffff;
}

QListView::item:hover:!selected, QTreeView::item:hover:!selected {
    background-color: #45494c;
    color: #e0e0e0;
}

/* Tree branch icons */
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/qt-project.org/styles/commonstyle/images/branch-closed-inverted-16.png);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/qt-project.org/styles/commonstyle/images/branch-open-inverted-16.png);
}

/* Headers */
QHeaderView::section {
    background-color: #3c3f41;
    color: #d0d0d0;
    border: 1px solid #4a4a4a;
    font-weight: bold;
    padding: 6px;
    font-size: 10pt;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #2b2b2b;
    border: 1px solid #404040;
    width: 14px;
    margin: 1px 0 1px 0;
    border-radius: 7px;
}

QScrollBar::handle:vertical {
    background-color: #555555;
    border: 1px solid #656565;
    min-height: 25px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: #6a6a6a;
    border-color: #7a7a7a;
}

QScrollBar:horizontal {
    background-color: #2b2b2b;
    border: 1px solid #404040;
    height: 14px;
    margin: 0 1px 0 1px;
    border-radius: 7px;
}

QScrollBar::handle:horizontal {
    background-color: #555555;
    border: 1px solid #656565;
    min-width: 25px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #6a6a6a;
    border-color: #7a7a7a;
}

/* Line edits and text edits */
QLineEdit, QTextEdit, QPlainTextEdit {
    border: 1px solid #4a4a4a;
    background-color: #313335;
    color: #d0d0d0;
    font-size: 10pt;
    padding: 6px 10px;
    border-radius: 4px;
    selection-background-color: #4b6eaf;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #5a86d1;
    background-color: #35393d;
}

QLineEdit:read-only, QTextEdit:read-only, QPlainTextEdit:read-only {
    background-color: #3c3f41;
    color: #808080;
}

QMenuBar {
    background-color: #ffffff !important;
    color: #212529 !important;
    font-weight: 450 !important;
    padding: 4px 8px !important;
    border-bottom: 1px solid #adb5bd;
    font-size: 10pt !important;
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif !important;
    user-select: none;
}

QMenuBar::item {
    background-color: transparent;
    color: #212529 !important;
    font-weight: 500 !important;
    padding: 4px 8px;
    border-radius: 3px;
    outline: none;
}

QMenuBar::item:selected {
    background-color: #e9ecef !important;
    color: #0056b3 !important;
    font-weight: 450 !important;
    border-radius: 3px;
}

QMenuBar::item:pressed {
    background-color: #ced4da !important;
    color: black !important;
    font-weight: 450 !important;
    border-radius: 3px;
}

QMenuBar::item:focus {
    outline: 2px solid #0056b3;
    outline-offset: 2px;
}

QWidget > QMenuBar {
    background-color: #ffffff !important;
    color: #212529 !important;
    font-weight: 450 !important;
    padding: 4px 8px !important;
    border-bottom: 1px solid #adb5bd;
    font-size: 10pt !important;
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif !important;
}

/* Menus */
QMenu {
    background-color: #ffffff;
    border: 1px solid #adb5bd;
    padding: 6px 0;
    color: #212529;
    border-radius: 4px;
    min-width: 150px;
    font-size: 10pt;
}

QMenu::item {
    padding: 8px 25px;
    margin: 2px 4px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #007bff;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #adb5bd;
}

QMenu::separator {
    height: 1px;
    background-color: #e9ecef;
    margin: 4px 8px;
}

/* Tooltips */
QToolTip {
    background-color: #f0f0f0;
    color: #1d1d1d;
    padding: 5px 8px;
    border-radius: 3px;
    border: 1px solid #cccccc;
    font-size: 9pt;
}

/* Status Bar */
QStatusBar {
    background-color: #3c3f41;
    color: #b0b0b0;
    border-top: 1px solid #4a4a4a;
    font-size: 9pt;
}

QStatusBar QLabel {
    padding: 0 4px;
}

/* Dock Widgets */
QDockWidget {
    color: #d0d0d0;
    font-weight: bold;
}

QDockWidget::title {
    background-color: #353535;
    border: 1px solid #4a4a4a;
    border-bottom: 1px solid #5a5a5a;
    padding: 6px;
    text-align: left;
}

/* Splitter handles */
QSplitter::handle {
    background-color: #3c3f41;
    border: 1px solid #4a4a4a;
}

QSplitter::handle:hover {
    background-color: #4a4a4a;
}

/* Combo boxes */
QComboBox {
    border: 1px solid #4a4a4a;
    background-color: #313335;
    color: #d0d0d0;
    selection-background-color: #4b6eaf;
    font-size: 10pt;
    padding: 6px 10px;
    border-radius: 4px;
}

QComboBox:hover {
    border-color: #5a5a5a;
}

QComboBox:focus {
    border-color: #5a86d1;
}

QComboBox::drop-down {
    border-left-color: #4a4a4a;
    background-color: #3c3f41;
}

QComboBox::down-arrow {
    image: url(:/qt-project.org/styles/commonstyle/images/arrow-down-inverted-16.png);
}

QComboBox::down-arrow:on {
    top: 1px;
    left: 1px;
}

/* Combo box list view */
QComboBox QAbstractItemView {
    border: 1px solid #555555;
    background-color: #3c3f41;
    color: #d0d0d0;
    selection-background-color: #4b6eaf;
    selection-color: #ffffff;
    padding: 4px;
    border-radius: 3px;
}

/* Spin boxes */
QSpinBox {
    border: 1px solid #4a4a4a;
    background-color: #313335;
    color: #d0d0d0;
    selection-background-color: #4b6eaf;
    selection-color: #ffffff;
    font-size: 10pt;
    padding: 6px 10px;
    border-radius: 4px;
}

QSpinBox:focus {
    border-color: #5a86d1;
}

QSpinBox::up-button, QSpinBox::down-button {
    border-left-color: #4a4a4a;
    background-color: #3c3f41;
}

QSpinBox::up-button {
    image: url(:/qt-project.org/styles/commonstyle/images/arrow-up-inverted-16.png);
}

QSpinBox::down-button {
    image: url(:/qt-project.org/styles/commonstyle/images/arrow-down-inverted-16.png);
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #4a4a4a;
}

QSpinBox::up-button:pressed, QSpinBox::down-button:pressed {
    background-color: #555555;
}

/* Checkboxes */
QCheckBox {
    color: #d0d0d0;
    font-size: 10pt;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #6a6a6a;
    border-radius: 3px;
    background-color: #3c3f41;
}

QCheckBox::indicator:hover {
    border-color: #5a86d1;
    background-color: #45494c;
}

QCheckBox::indicator:checked {
    background-color: #4b6eaf;
    border-color: #4b6eaf;
    image: url(:/qt-project.org/styles/commonstyle/images/checkbox-checked-inverted-16.png);
}

QCheckBox::indicator:indeterminate {
    background-color: #4b6eaf;
    border-color: #4b6eaf;
    image: url(:/qt-project.org/styles/commonstyle/images/checkbox-indeterminate-inverted-16.png);
}

QCheckBox::indicator:disabled {
    background-color: #4a4a4a;
    border-color: #5a5a5a;
}

/* Progress bar */
QProgressBar {
    border: 1px solid #5a5a5a;
    background-color: #3c3f41;
    color: #b0b0b0;
    font-weight: bold;
    font-size: 9pt;
    border-radius: 4px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #4b6eaf;
    border-radius: 3px;
    margin: 1px;
}
