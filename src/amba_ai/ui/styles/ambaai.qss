QWidget {
    font-family: "Segoe UI", "Roboto", "Helvetica Neue", Tahoma, sans-serif;
    font-size: 10pt;
    color: #e0e0e0;
    background-color: #1e1e1e;
}

QMainWindow {
    background-color: #121212;
}

QMenuBar {
    background-color: #1f1f1f;
    color: #e0e0e0;
    font-size: 10pt;
    padding: 4px 8px;
    border-bottom: 1px solid #333;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 8px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #333;
    color: #4EC9B0;
}

QMenuBar::item:pressed {
    background-color: #007ACC;
    color: #fff;
}

QMenu {
    background-color: #2b2b2b;
    border: 1px solid #444;
    padding: 6px 0;
    color: #e0e0e0;
    border-radius: 4px;
    min-width: 150px;
    font-size: 10pt;
}

QMenu::item {
    padding: 6px 20px;
    margin: 2px 4px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #094771;
    color: #fff;
}

QMenu::separator {
    height: 1px;
    background-color: #444;
    margin: 4px 8px;
}

QToolBar {
    background-color: #1f1f1f;
    border-bottom: 1px solid #333;
    padding: 4px 8px;
}

QToolButton {
    color: #d0d0d0;
    background-color: transparent;
    border: 1px solid transparent;
    padding: 6px 10px;
    margin: 1px;
    border-radius: 4px;
    font-size: 10pt;
}

QToolButton:hover {
    background-color: #2d2d2d;
    border: 1px solid #444;
    color: #4EC9B0;
}

QToolButton:pressed {
    background-color: #007ACC;
    color: #fff;
}

QToolButton:checked {
    background-color: #007ACC;
    border: 1px solid #007ACC;
    color: #fff;
}

QToolButton:disabled {
    color: #666;
}

QStatusBar {
    background-color: #1f1f1f;
    color: #e0e0e0;
    border-top: 1px solid #333;
    font-size: 9pt;
}

QTabWidget::pane {
    border: 1px solid #333;
    background-color: #1e1e1e;
}

QTabBar::tab {
    background-color: #252526;
    border: 1px solid #333;
    color: #888;
    padding: 8px 16px;
    min-width: 90px;
    font-size: 10pt;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #1e1e1e;
    color: #fff;
    border-top: 2px solid #007ACC;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background-color: #2d2d2d;
    color: #ccc;
}

QPushButton {
    background-color: #0e639c;
    border: 1px solid #094770;
    color: #fff;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: 600;
    min-width: 90px;
}

QPushButton:hover {
    background-color: #1177bb;
    border-color: #4daafc;
}

QPushButton:pressed {
    background-color: #094770;
    border-color: #007ACC;
}

QPushButton:disabled {
    background-color: #333;
    border-color: #444;
    color: #666;
}

QPushButton#SecondaryBtn {
    background-color: #3a3a3a;
    color: #ddd;
    border: 1px solid #555;
}

QPushButton#SecondaryBtn:hover {
    background-color: #4a4a4a;
}

QLineEdit, QComboBox, QPlainTextEdit, QTextEdit {
    border: 1px solid #3e3e42;
    background-color: #2d2d2d;
    color: #f0f0f0;
    font-size: 10pt;
    padding: 6px 10px;
    border-radius: 4px;
}

QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border: 1px solid #007ACC;
    background-color: #333;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #3e3e42;
    background-color: #2d2d2d;
}

QTextBrowser {
    background-color: #1e1e1e;
    border: 1px solid #333;
    border-radius: 4px;
    padding: 10px;
}

QHeaderView::section {
    background-color: #252526;
    color: #ccc;
    border: none;
    border-bottom: 1px solid #333;
    border-right: 1px solid #333;
    font-weight: bold;
    padding: 6px;
}

QScrollBar:vertical {
    background: #1e1e1e;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #424242;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #555;
}

QScrollBar:horizontal {
    background: #1e1e1e;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #424242;
    min-width: 20px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: #555;
}

QProgressBar {
    height: 20px;
    text-align: center;
    border: 1px solid #3e3e42;
    border-radius: 4px;
    color: #e0e0e0;
    background-color: #2d2d2d;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: #007ACC;
    border-radius: 3px;
}

QFrame#Card {
    background-color: #1e1e1e;
    border: 1px solid #333;
    border-radius: 8px;
    padding: 12px;
}

QLabel#HeaderLabel {
    color: #4EC9B0;
    font-size: 18pt;
    font-weight: bold;
    margin-bottom: 8px;
}

QLabel#SubHeaderLabel {
    color: #dcdcdc;
    font-size: 14pt;
    font-weight: 600;
    margin-top: 12px;
}

QLabel#StatsValue {
    font-size: 24pt;
    font-weight: bold;
    color: #4EC9B0;
}

QLabel#TooltipContent {
    background: transparent;
    color: #f5f5f5;
    padding: 8px 12px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 11pt;
}

QLabel#TooltipContent a {
    color: #87cefa;
    text-decoration: none;
    font-weight: bold;
}

QLabel#TooltipContent a:hover {
    color: #ffffff;
    text-decoration: underline;
}

/* ============================================================
   CUSTOM TOOLTIP SCROLLABLE FIX
   ============================================================ */

CustomToolTip {
    background: transparent;
    border: none;
}

QFrame#TooltipCard {
    background-color: #2b2b2b;
    border: 1px solid #5a5a5a;
    border-radius: 6px;
}

QScrollArea {
    background: transparent;
    border: none;
}
QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* Scrollbar styling for tooltip scroll area */
QScrollBar:vertical {
    background: #2b2b2b;
    width: 10px;
    margin: 2px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #555;
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* Horizontal scrollbar styling (for completeness, though disabled in tooltip) */
QScrollBar:horizontal {
    background: #2b2b2b;
    height: 10px;
    margin: 2px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #555;
    min-width: 20px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background: #777;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}
