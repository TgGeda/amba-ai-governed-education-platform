QMainWindow { background-color: #121212; }
QWidget { color: #ffffff; background-color: #121212; font-family: Arial, sans-serif; font-size: 14px; }
QMenuBar { background-color: #000000; border-bottom: 2px solid #ffffff; }
QMenuBar::item:selected { background-color: #ffff00; color: #000000; }
QMenu { background-color: #000000; border: 2px solid #ffffff; }
QMenu::item:selected { background-color: #ffff00; color: #000000; }
QToolBar { background-color: #000000; border-bottom: 2px solid #ffffff; spacing: 8px; }
QToolButton { background-color: transparent; border: 1px solid #ffffff; border-radius: 0px; padding: 6px; }
QToolButton:hover, QToolButton:focus { background-color: #ffff00; color: #000000; border-color: #ffff00; }
QPushButton { background-color: #000000; color: #ffffff; border: 2px solid #ffffff; border-radius: 0px; padding: 8px 16px; font-weight: bold; outline: 2px solid #ffff00; }
QPushButton:hover, QPushButton:focus { background-color: #ffff00; color: #000000; border-color: #ffff00; }
QPushButton[priority="primary"] { background-color: #ffff00; color: #000000; border: 2px solid #ffff00; }
QPushButton[priority="primary"]:hover, QPushButton[priority="primary"]:focus { background-color: #ffffff; color: #000000; border-color: #ffffff; }
QPushButton[variant="secondary"] { background-color: #000000; color: #ffffff; border: 2px solid #ffffff; }
QPushButton[variant="secondary"]:hover, QPushButton[variant="secondary"]:focus { background-color: #ffff00; color: #000000; border-color: #ffff00; }
QTabWidget::pane { border: 2px solid #ffffff; background-color: #121212; border-radius: 0px; }
QTabBar::tab { background-color: #000000; border: 2px solid #ffffff; border-bottom: none; padding: 8px 16px; font-weight: bold; margin-right: 4px; }
QTabBar::tab:selected, QTabBar::tab:focus { background-color: #ffff00; color: #000000; border-color: #ffff00; }
QLabel { background-color: transparent; }
QLabel#ingestTitle { font-size: 22px; font-weight: bold; color: #ffff00; text-decoration: underline; }
QLabel#ingestSubtitle { font-size: 14px; color: #ffffff; }
QLabel#ingestDropHint { background-color: #000000; border: 2px dashed #ffffff; font-size: 14px; padding: 15px; }
QLabel[badge="offline"] { background-color: #ffff00; color: #000000; padding: 4px 10px; border: 2px solid #ffff00; font-weight: bold; }
QLineEdit { background-color: #000000; border: 2px solid #ffffff; color: #ffffff; padding: 6px; selection-background-color: #ffff00; selection-color: #000000; }
QLineEdit:focus { border: 2px solid #ffff00; }
QComboBox { background-color: #000000; border: 2px solid #ffffff; color: #ffffff; padding: 6px; }
QComboBox:focus { border: 2px solid #ffff00; }
QComboBox::drop-down { border-left: 2px solid #ffffff; }
QSpinBox { background-color: #000000; border: 2px solid #ffffff; color: #ffffff; padding: 6px; }
QSpinBox:focus { border: 2px solid #ffff00; }
QTextEdit, QTextBrowser, QPlainTextEdit { background-color: #000000; border: 2px solid #ffffff; color: #ffffff; padding: 10px; selection-background-color: #ffff00; selection-color: #000000; }
QTextEdit:focus, QTextBrowser:focus, QPlainTextEdit:focus { border: 2px solid #ffff00; }
QTreeView, QTableView, QListWidget { background-color: #000000; border: 2px solid #ffffff; color: #ffffff; }
QTreeView:focus, QTableView:focus, QListWidget:focus { border: 2px solid #ffff00; }
QHeaderView::section { background-color: #000000; border: 2px solid #ffffff; color: #ffffff; padding: 6px; font-weight: bold; }
QProgressBar { border: 2px solid #ffffff; text-align: center; background-color: #000000; font-weight: bold; }
QProgressBar::chunk { background-color: #ffff00; }
QStatusBar { background-color: #000000; border-top: 2px solid #ffffff; }